{% comment %}
  Header icons: search, account, wishlist, compare, cart

  Accepts:
  - section: {Object} Section paramatres object
  - hide_search_opened: {Boolean} default false
  - disable_phones_block: {String} default empty. Value = disable

  Usage:
  {%- render "wk-header-user-icons",
      section:section,
      hide_search_opened:hide_search_opened
  -%}
{% endcomment %}

<div class="header__icons">
  {%- if disable_phones_block != "disable" -%}
  {% assign phone = section.blocks | where: "type", "phone" %}
  {%- for block in phone -%}
  {%- comment -%} Phone number + contacts dropdown replaced by a WhatsApp icon link {%- endcomment -%}
  {%- liquid
    assign whatsapp_url = block.settings.url__3
    if whatsapp_url == blank or whatsapp_url == '#'
      assign whatsapp_number = block.settings.phone__0 | remove: 'T:' | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | strip
      assign whatsapp_url = 'https://wa.me/' | append: whatsapp_number
    endif
  -%}
  {%- capture whatsapp_html -%}
  <a href="{{ whatsapp_url }}" class="header__button header__whatsapp{% if section.settings.icons_text != 'show_only_text' %} move-icon-up{% endif %} global__tooltip--hover" target="_blank" rel="noopener" aria-label="WhatsApp">
    <svg class="header__whatsapp-icon" aria-hidden="true" focusable="false" width="20" height="20" viewBox="2.4 2.4 19.2 19.2" fill="none" stroke-width="1.05" stroke-linecap="round" stroke-linejoin="round" style="stroke:var(--color-text-icons-block, var(--color-base-section, var(--color-text-icons-main, currentColor)))"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9l-5.05.9"/><path d="M9 10a.5.5 0 0 0 1 0v-1a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/></svg>
    {%- if section.settings.icons_text == 'tooltip' -%}
    <wk-global-tooltip class="global__tooltip global__tooltip__static">
      <div class="global__tooltip__content">WhatsApp</div>
    </wk-global-tooltip>
    {%- endif -%}
  </a>
  {%- endcapture -%}
  {%- endfor -%}
  {%- endif -%}

  {%- unless section.settings.classic_menu_position contains "bottom-menu-to" -%}
  {%- unless hide_search_opened -%}
  {%- render "wk-header-search-opened", show_search:section.settings.show_search, fullwidth: false -%}
  {%- endunless -%}
  {%- endunless -%}
  
  <div class="header__icons__customer__icons{% if section.settings.icons_text == 'show' %} gap-20{% endif %}">
    {%- comment -%} WhatsApp sits in the same icon group as account / compare / wishlist / cart {%- endcomment -%}
    {{ whatsapp_html }}
    {%- if section.settings.show_search == "closed" -%}
    {%- unless section.settings.classic_menu_position contains "bottom-menu-to" and section.settings.logo_position == 'logo-to-center' -%}
    {%- unless hide_search_opened -%}
    {%- render "wk-header-search-closed", section:section -%}
    {%- endunless -%}
    {%- endunless -%}
    {%- endif -%}
    {%- if shop.customer_accounts_enabled -%}
    {%- if routes.account_login_url contains "/account/login" -%}
    <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header__button{% if section.settings.icons_text != 'show_only_text' %} move-icon-up{% endif %} global__tooltip--hover">
      {%- if section.settings.icons_text != 'show_only_text' -%}
      {{- 'wk-icon-account' | append: settings.wk_system_icon_thickness | inline_asset_content -}}
      {%- endif -%}
      <span class="body2 header__button__bubble__text">
        {%- liquid
          if customer
            echo 'customer.account_fallback' | t
          else
            echo 'customer.log_in' | t
          endif
        -%}
      </span>
      {%- if section.settings.icons_text == 'tooltip' -%}
      <wk-global-tooltip class="global__tooltip global__tooltip__static">
        <div class="global__tooltip__content">
        {%- liquid
          if customer
            echo 'customer.account_fallback' | t
          else
            echo 'customer.log_in' | t
          endif
        -%}
        </div>
      </wk-global-tooltip>
      {%- endif -%}
    </a>
    {%- else -%}
    <div class="header-customer-accounts">
      <div class="header__button{% if section.settings.icons_text != 'show_only_text' %} move-icon-up{% endif %} global__tooltip--hover">
        {%- if section.settings.icons_text != 'show_only_text' -%}
        {{- 'wk-icon-account' | append: settings.wk_system_icon_thickness | inline_asset_content -}}
        {%- endif -%}
        <span class="body2 header__button__bubble__text">
          {%- liquid
            if customer
              echo 'customer.account_title' | t
            else
              echo 'customer.log_in' | t
            endif
          -%}
        </span>
      </div>
      <div class="header-customer-accounts__modal">
        <p class="mt0 header-customer-accounts__modal__header">
          <span class="header-customer-accounts__modal__title h6">
            {% if customer and customer.first_name != blank %}
              {{ 'customer.account_title_personalized' | t: first_name: customer.first_name }}
            {% else %}
              {{ 'customer.account_title' | t }}
            {% endif %}
          </span>
          {% if customer %}
          <span class="mt5 display-block header-customer-accounts__modal__email body2">
            {% if customer.email %}
              {{ customer.email }}
            {% elsif customer.phone %}
              {{ customer.phone }}
            {% endif %}
          </span>
          {% endif %}
        </p>
        <div class="header-customer-accounts__modal__buttons">
          {% unless customer %}
            <div class="account-actions__sign-ins" data-skip-subtree-update="true">
              <script src="{{ 'wk-account-login-actions.js' | asset_url }}" type="module" fetchpriority="low"></script>
              <wk-account-login-actions class="account-actions__shop-login">{{ shop | login_button }}</wk-account-login-actions>
              <a href="{% if request.design_mode %}{{ routes.account_url }}{% else %}{{ routes.storefront_login_url }}{% endif %}" class="btn btn__transition-text w-full">
                <div class="btn__texts">
                  <span class="btn__top-text is-visible">
                    <span class="account-actions__sign-in-text">{{ 'customer.sign_in_options' | t }}</span>
                    <span class="account-actions__fallback-text">{{ 'customer.log_in' | t }}</span>
                  </span>
                  <span class="btn__bottom-text is-hidden">
                    <span class="account-actions__sign-in-text">{{ 'customer.sign_in_options' | t }}</span>
                    <span class="account-actions__fallback-text">{{ 'customer.log_in' | t }}</span>
                  </span>
                </div>
              </a>
            </div>
          {% endunless %}
          <div class="header-customer-accounts__nav">
            <a href="{{ routes.account_url }}" class="btn btn--border btn__transition-text w-full">
              <div class="btn__texts">
                <span class="btn__top-text is-visible">{% if section.settings.icons_text != 'show_only_text' %}{{- 'wk-icon-account-orders' | append: settings.wk_system_icon_thickness | inline_asset_content -}}{% endif %}{{ 'customer.account_orders' | t }}</span>
                <span class="btn__bottom-text is-hidden">{% if section.settings.icons_text != 'show_only_text' %}{{- 'wk-icon-account-orders' | append: settings.wk_system_icon_thickness | inline_asset_content -}}{% endif %}{{ 'customer.account_orders' | t }}</span>
              </div>
            </a>
            <a href="{{ routes.account_addresses_url }}" class="btn btn--border btn__transition-text w-full">
              <div class="btn__texts">
                <span class="btn__top-text is-visible">{% if section.settings.icons_text != 'show_only_text' %}{{- 'wk-icon-account' | append: settings.wk_system_icon_thickness | inline_asset_content -}}{% endif %}{{ 'customer.account_profile' | t }}</span>
                <span class="btn__bottom-text is-hidden">{% if section.settings.icons_text != 'show_only_text' %}{{- 'wk-icon-account' | append: settings.wk_system_icon_thickness | inline_asset_content -}}{% endif %}{{ 'customer.account_profile' | t }}</span>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
    {%- endif -%}
    {%- endif -%}

    {%- if settings.wk_enable_compare -%}
    <a href="{{ settings.wk_page_compare.url }}" class="header__button{% if section.settings.icons_text != 'show_only_text' %} move-icon-up{% endif %} global__tooltip--hover">
      {%- if section.settings.icons_text == 'show_only_text' -%}
      <span class="body2 header__button__bubble__text">{{ 'compare.header.icon_compare' | t }}: <wk-compare-bubble><span class="header__button__bubble__count">0</span></wk-compare-bubble></span>
      {%- else -%}
	    {{- 'wk-icon-compare' | append: settings.wk_system_icon_thickness | inline_asset_content -}}
      <span class="body2 header__button__bubble__text">{{ 'compare.header.icon_compare' | t }}</span>
      <wk-compare-bubble class="header__button__bubble">
        <span class="body3-no-scale header__button__bubble__count"></span>
      </wk-compare-bubble>
      {%- if section.settings.icons_text == 'tooltip' -%}
      <wk-global-tooltip class="global__tooltip global__tooltip__static">
        <div class="global__tooltip__content">{{ 'compare.header.icon_compare' | t }}</div>
      </wk-global-tooltip>
      {%- endif -%}
      {%- endif -%}
    </a>
    {%- endif -%}
    {%- if settings.wk_enable_wishlist -%}
    <a href="{{ settings.wk_page_wishlist.url }}" class="header__button{% if section.settings.icons_text != 'show_only_text' %} move-icon-up{% endif %} global__tooltip--hover">
      {%- if section.settings.icons_text == 'show_only_text' -%}
      <span class="body2 header__button__bubble__text">{{ 'wishlist.header.icon_wishlist' | t }}: <wk-wishlist-bubble><span class="header__button__bubble__count">0</span></wk-wishlist-bubble></span>
      {%- else -%}
      {%- render 'wk-icon-wishlist', icon_type:"normal" -%}
      <span class="body2 header__button__bubble__text">{{ 'wishlist.header.icon_wishlist' | t }}</span>
      <wk-wishlist-bubble class="header__button__bubble">
        <span class="body3-no-scale header__button__bubble__count"></span>
      </wk-wishlist-bubble>
      {%- if section.settings.icons_text == 'tooltip' -%}
      <wk-global-tooltip class="global__tooltip global__tooltip__static">
        <div class="global__tooltip__content">{{ 'wishlist.header.icon_wishlist' | t }}</div>
      </wk-global-tooltip>
      {%- endif -%}
      {%- endif -%}
    </a>
    {%- endif -%}
    {%- if settings.wk_cart_type != "catalog_mode" -%}
    {%- if section.settings.icons_text == 'show_only_text' -%}
    <a href="{{ routes.cart_url }}" class="header__button global__tooltip--hover" id="wk-cart-icon-bubble-short">
      {%- render 'wk-cart-icon-bubble-short' -%}
    </a>
    {%- else -%}
    <a href="{{ routes.cart_url }}" class="header__button move-icon-up global__tooltip--hover" id="wk-cart-icon-bubble">
      {%- render 'wk-cart-icon-bubble' -%}
      {%- if section.settings.icons_text == 'tooltip' -%}
      <wk-global-tooltip class="global__tooltip global__tooltip__static">
        <div class="global__tooltip__content">{{ 'sections.header.icon_cart' | t }}</div>
      </wk-global-tooltip>
      {%- endif -%}
    </a>
    {%- endif -%}
    {%- endif -%}
  </div>
</div>