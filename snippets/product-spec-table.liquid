{%- comment -%}
  Specifications table for the product page. Rows come from the product metafield specs.rows
  (a list of "Specification row" metaobjects, each with a heading and a value), in the order added.
  Renders nothing when the product has no rows.
  Accepts: product
{%- endcomment -%}
{%- assign spec_rows = product.metafields.specs.rows.value -%}
{%- if spec_rows != blank and spec_rows.size > 0 -%}
  <table class="spec-table">
    <tbody>
      {%- for row in spec_rows -%}
        {%- if row.label != blank -%}
          <tr><th scope="row">{{ row.label | escape }}</th><td>{{ row.value | escape }}</td></tr>
        {%- endif -%}
      {%- endfor -%}
    </tbody>
  </table>
  <style>
    .spec-table{ width:100%; max-width:560px; border-collapse:collapse; margin:0; }
    .spec-table th, .spec-table td{ padding:16px 0; border-bottom:1px solid rgba(0,0,0,.12); text-align:start; vertical-align:middle; }
    .spec-table th{ width:46%; padding-inline-end:16px; font-weight:500; font-size:14px; letter-spacing:.06em; text-transform:uppercase; }
    .spec-table td{ font-size:14px; opacity:.85; }
    @media (max-width:749px){ .spec-table th, .spec-table td{ padding:13px 0; font-size:13px; } .spec-table th{ width:50%; } }
  </style>
{%- endif -%}
