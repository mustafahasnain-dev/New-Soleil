{%- comment -%}
  Specifications table for the product page. Rows come from the product metafield specs.rows
  (a list of "Specification row" metaobjects, each with a heading and a value), in the order added.
  Renders nothing when the product has no rows.
  Accepts: product
{%- endcomment -%}
{%- assign spec_rows = product.metafields.specs.rows.value -%}
{%- if spec_rows != blank and spec_rows.size > 0 -%}
  <table class="spec-table">
    <tbody>
      {%- for row in spec_rows -%}
        {%- if row.label != blank -%}
          <tr><th scope="row">{{ row.label | escape }}</th><td>{{ row.value | escape }}</td></tr>
        {%- endif -%}
      {%- endfor -%}
    </tbody>
  </table>
  <style>
    /* minimalist.ae style: no outer/vertical borders, thin divider under each row */
    .mpc-tab__content .spec-table, .spec-table{ width:100%; max-width:560px; border:0 !important; border-collapse:collapse; border-spacing:0; margin:0; table-layout:fixed; }
    .mpc-tab__content .spec-table tr, .spec-table tr{ border:0 !important; background:none !important; }
    .mpc-tab__content .spec-table th, .mpc-tab__content .spec-table td,
    .spec-table th, .spec-table td{ padding:18px 0 !important; border:0 !important; border-bottom:1px solid #e5e5e5 !important; background:none !important; text-align:start; vertical-align:middle; }
    .mpc-tab__content .spec-table th, .spec-table th{ width:46%; padding-inline-end:16px !important; font-size:14px; font-weight:500; letter-spacing:.04em; text-transform:uppercase; color:#111; }
    .mpc-tab__content .spec-table td, .spec-table td{ font-size:13px; font-weight:400; letter-spacing:.02em; text-transform:none; color:#555; }
    @media (max-width:749px){
      .mpc-tab__content .spec-table th, .mpc-tab__content .spec-table td, .spec-table th, .spec-table td{ padding:14px 0 !important; }
      .mpc-tab__content .spec-table th, .spec-table th{ font-size:13px; width:50%; }
    }
  </style>
{%- endif -%}
