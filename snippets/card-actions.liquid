{%- comment -%}
  Hover action icons on product cards: add to cart, wishlist, compare.
  Wishlist / compare use the same localStorage keys as the header counters (productDataWishlist /
  productDataCompare, product id -> handle) and fire wishlistUpdated / compareUpdated.
  Behaviour: assets/card-actions.js. Styles: assets/card-actions.css. Both load in layout/theme.liquid.
  Accepts: card_product
{%- endcomment -%}
{%- liquid
  assign first_variant = card_product.selected_or_first_available_variant
  assign single_variant = false
  if card_product.has_only_default_variant or card_product.variants.size == 1
    assign single_variant = true
  endif
-%}
<div class="card-actions">
  {%- if card_product.available -%}
    <button
      type="button"
      class="card-actions__btn"
      data-card-action="cart"
      data-variant-id="{{ first_variant.id }}"
      data-single="{{ single_variant }}"
      data-url="{{ card_product.url }}"
      aria-label="{% if single_variant %}Add to cart{% else %}Choose options{% endif %}"
      title="{% if single_variant %}Add to cart{% else %}Choose options{% endif %}"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
    </button>
  {%- endif -%}
  {%- if settings.wk_enable_wishlist -%}
    <button
      type="button"
      class="card-actions__btn"
      data-card-action="wishlist"
      data-id="{{ card_product.id }}"
      data-product-handle="{{ card_product.handle }}"
      aria-label="Add to wishlist"
      title="Add to wishlist"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"/></svg>
    </button>
  {%- endif -%}
  {%- if settings.wk_enable_compare -%}
    <button
      type="button"
      class="card-actions__btn"
      data-card-action="compare"
      data-id="{{ card_product.id }}"
      data-product-handle="{{ card_product.handle }}"
      aria-label="Add to compare"
      title="Add to compare"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M7 4 4 7l3 3"/><path d="M4 7h12"/><path d="m17 14 3 3-3 3"/><path d="M20 17H8"/></svg>
    </button>
  {%- endif -%}
</div>
