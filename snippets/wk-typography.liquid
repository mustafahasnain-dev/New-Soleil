{%- comment -%}
  Site-wide typography matched to the Wokiee theme (C:/Work/Soleil/Soleil, assets/base.css + snippets/head-styles.liquid).
  Fonts come from Dawn's own font settings (Theme settings > Typography), set to Josefin Sans.
{%- endcomment -%}
{% style %}
  body {
    font-size: 1.6rem;
    line-height: normal;
    letter-spacing: 0;
    color: #000;
  }
  h1, h2, h3, h4, h5, h6,
  .h0, .h1, .h2, .h3, .h4, .h5, .h6 {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: normal;
    letter-spacing: 0;
    word-break: break-word;
  }
  h1, .h1 { font-size: 4.8rem; }
  h2, .h2 { font-size: 4rem; }
  h3, .h3 { font-size: 3.2rem; }
  h4, .h4 { font-size: 2.4rem; }
  h5, .h5 { font-size: 1.9rem; }
  h6, .h6 { font-size: 1.6rem; }
  @media screen and (max-width: 576px) {
    h1, .h1 { font-size: 3.6rem; }
    h2, .h2 { font-size: 3.2rem; }
    h3, .h3 { font-size: 2.8rem; }
  }
{% endstyle %}
