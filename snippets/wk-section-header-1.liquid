{%- liquid
    assign secondary_menu = ""
    assign secondary_menu_links = ""
    assign social_media = ""
    assign country_selector = ""
    assign language_selector = ""
    assign mega_menu_index = '|'
    assign svg_icons = ''
    for block in section.blocks
    case block.type
    when 'main_menu_icons'
    assign svg_icons = block
    when 'mega_menu'
    assign mega_menu_index = mega_menu_index | append: block.settings.mega_menu_item_name | append: '%%' | append: forloop.index0 | append: '|'
    endcase
    endfor
    assign block_topbar = section.blocks | where: "type", "topbar"
    assign block_topbar_object = section.blocks | where: "type", "topbar"
    for block in block_topbar
    assign block_topbar_object = block
    assign secondary_menu_links = block.settings.secondary_menu.links
    capture secondary_menu
    render 'wk-header-menu-secondary' linklist: block.settings.secondary_menu.links animation: 'menu--animation-underline'
    endcapture
    capture social_media
    render "wk-header-social-media", block:block
    endcapture
    capture country_selector
    render "wk-header-country-selector", block:block
    endcapture
    capture language_selector
    render "wk-header-language-selector", block:block
    endcapture
    endfor

    render "wk-section-css-background-header", section:section, block_topbar_object:block_topbar_object
    render "wk-section-component-top-line", section:section

    assign sec_bg_desk = true
    if template == "index" and settings.wk_fixed_header_on_index
    assign sec_bg_desk = false
    endif
    if section.settings.background_width == "fullwidth"
    assign background_width_fullwidth = true
    elsif template == "index" and settings.wk_fixed_header_on_index
    assign background_width_fullwidth = true
    else
    assign background_width_fullwidth = false
    endif

    capture page_width
    if section.settings.width != "default"
    echo section.settings.width
    else
    echo settings.wk_page_width_main
    endif
    endcapture
    assign topbar_settings_background = false
    if block_topbar_object.settings.background != 'hide' and section.settings.background_width == "content_width" and sec_bg_desk
    assign topbar_settings_background = true
    endif
    assign section_settings_background = false
    if section.settings.background != 'hide' and section.settings.background_width == "content_width" and sec_bg_desk
    assign section_settings_background = true
    endif
-%}


<header id="theme-section-{{ section.id }}"
        data-role="{{ theme.role }}"
        data-section-name="header-layout-classic"
  >
    <div class="header__mobile{% if section.settings.background != 'hide' and background_width_fullwidth %} section-background{% endif %}">
      {%- render "wk-header-mobile",
          section: section,
          page_width:page_width,
          secondary_menu_links:secondary_menu_links,
          social_media: social_media,
          country_selector: country_selector,
          language_selector:language_selector,
          svg_icons:svg_icons
      -%}
    </div>
    <wk-header-desktop class="header__desktop{% unless section.settings.icons_text contains 'show' %} header__hide-icon-text{% endunless %}{% if settings.wk_show_shadow_header %} header__desktop__shadow{% endif %}">
      <div class="{{ page_width }} header-boxed-shadow">
        <div class="header-boxed-shadow__item"></div>
      </div>

      {%- render "wk-header-topbar",
          block_topbar:block_topbar,
          block_topbar_object:block_topbar_object,
          topbar_settings_background:topbar_settings_background,
          page_width:page_width,
          secondary_menu:secondary_menu,
          social_media:social_media,
          country_selector:country_selector,
          language_selector:language_selector          
      -%}
      <div class="header__main header-layout-classic{% if section.settings.background != 'hide' and background_width_fullwidth %} section-background{% endif %}">
        {%- if section.settings.show_top_line -%}
        <div{% if section.settings.width_line == "content" %} class="{{ page_width }}"{% endif %}>
          <div class="header__line"></div>
        </div>
        {%- endif -%}
        <div class="{{ page_width }}">
          {%- if section_settings_background -%}<div class="section-background header__section-background__boxed border__radius">{%- endif -%}
          <div class="header {{ section.settings.logo_position }} {{ section.settings.classic_menu_position }}">
            {%- capture logo -%}{%- render "wk-header-logo-desktop",section:section -%}{%- endcapture -%}

            {%- if section.settings.logo_position == 'logo-to-center' and section.settings.classic_menu_position == 'top-menu-to-center' -%}
            {%- liquid
                if section.settings.show_search == "closed"
                assign hide_search_opened = false
                else
                assign hide_search_opened = true
                endif
            -%}
            <div>{%- render "wk-header-search-opened", show_search:section.settings.show_search, fullwidth: false -%}</div>

            <wk-menuwith-logo class="menu-center__logo-center__container">
            {%- liquid
                if section.settings.menu != blank
                render 'wk-header-menu', linklist:section.settings.menu.links, animation:'menu--animation-underline', mega_menu_index:mega_menu_index, menu_font_weight:section.settings.menu_font_weight, page_width:page_width, custom_class:"desktop-main-menu", end_count:section.settings.break_main_menu_count
                else
                echo '<div></div>'
                endif
            -%}
            
            {{ logo }}

            {%- liquid
                if section.settings.menu != blank
                render 'wk-header-menu', linklist:section.settings.menu.links, animation:'menu--animation-underline', mega_menu_index:mega_menu_index, menu_font_weight:section.settings.menu_font_weight, page_width:page_width, custom_class:"desktop-main-menu", start_count:section.settings.break_main_menu_count
                else
                echo '<div></div>'
                endif
            -%}
            </wk-menuwith-logo>

            {%- else -%}
            {%- assign hide_search_opened = false -%}

            {% if section.settings.logo_position == 'logo-to-left' %}{{ logo }}{% endif %}

            {%- liquid
                if section.settings.menu != blank
                render 'wk-header-menu', linklist:section.settings.menu.links, animation:'menu--animation-underline', mega_menu_index:mega_menu_index, menu_font_weight:section.settings.menu_font_weight, page_width:page_width, custom_class:"desktop-main-menu"
                elsif section.settings.classic_menu_position == "top-menu-to-"
                echo '<div></div>'
                else
                echo '<div></div>'
                endif
            -%}

            {%- if section.settings.classic_menu_position contains "bottom-menu-to" and section.settings.logo_position == 'logo-to-center' -%}
            {%- render "wk-header-search-opened", show_search:section.settings.show_search, fullwidth: false -%}
            {%- if section.settings.show_search == "closed" -%}
            {%- render "wk-header-search-closed", section:section -%}
            {%- elsif section.settings.show_search == "hide" -%}
            <div></div>
            {%- endif -%}
            {%- endif -%}
  
            {% if section.settings.logo_position == 'logo-to-center' %}{{ logo }}{% endif %}
  
            {%- endif -%}

            {%- if section.settings.classic_menu_position contains "bottom-menu-to" and section.settings.logo_position != 'logo-to-center' -%}
            {%- render "wk-header-search-opened", show_search:section.settings.show_search, fullwidth: true -%}
            {%- endif -%}

            
            {%- render "wk-header-user-icons", hide_search_opened:hide_search_opened -%}

          </div>
          {%- if section_settings_background -%}</div>{%- endif -%}
        </div>
        {%- if section.settings.show_bottom_line -%}
        <div{% if section.settings.width_line == "content" %} class="{{ page_width }}"{% endif %}>
          <div class="header__line"></div>
        </div>
        {%- endif -%}
      </div>


      
  </wk-header-desktop>
</header>

