{%- comment -%}
  Line icons for the custom product page.
  Usage: {% render 'mpc-icon', name: 'gift' %}
{%- endcomment -%}
<svg class="mpc-icon mpc-icon--{{ name }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- case name -%}
  {%- when 'feather' -%}
    <path d="M20.2 3.8c-5.6-.6-10.9 2.6-12.9 7.8L5 20"/><path d="M20.2 3.8c.4 5.2-2.9 10.3-8 12.1l-4.9 1.1"/><path d="M9.3 14.3l4.2-4.2"/><path d="M12 12.6h4.6"/><path d="M11.1 8.2v4.4"/>
  {%- when 'moon' -%}
    <path d="M20 14.6A8.5 8.5 0 1 1 9.4 4a6.8 6.8 0 0 0 10.6 10.6z"/><path d="M16.5 3.5l.5 1.4 1.4.5-1.4.5-.5 1.4-.5-1.4-1.4-.5 1.4-.5z"/>
  {%- when 'resize' -%}
    <path d="M4 9V4h5"/><path d="M4 4l6 6"/><path d="M20 15v5h-5"/><path d="M20 20l-6-6"/>
  {%- when 'shield' -%}
    <path d="M12 3l7.5 3v5.4c0 4.6-3.1 8.4-7.5 9.6-4.4-1.2-7.5-5-7.5-9.6V6z"/>
  {%- when 'leaf' -%}
    <circle cx="12" cy="12" r="8.5"/><path d="M8.5 15.5c0-4.4 2.6-7 7-7 0 4.4-2.6 7-7 7z"/><path d="M8.5 15.5l3.5-3.5"/>
  {%- when 'layers' -%}
    <path d="M12 4L3 8.5 12 13l9-4.5z"/><path d="M3 12.5L12 17l9-4.5"/><path d="M3 16.5L12 21l9-4.5"/>
  {%- when 'gift' -%}
    <rect x="3.5" y="8" width="17" height="4" rx=".5"/><path d="M5 12v8.5h14V12"/><path d="M12 8v12.5"/><path d="M12 8c-1-2.8-4.5-4-5.4-2.1C5.8 7.5 8.8 8 12 8zM12 8c1-2.8 4.5-4 5.4-2.1.8 1.6-2.2 2.1-5.4 2.1z"/>
  {%- when 'heart' -%}
    <path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.6C19.5 15.4 12 20 12 20z"/>
  {%- when 'diamond' -%}
    <path d="M6.5 4h11L21 9l-9 11L3 9z"/><path d="M3 9h18"/><path d="M9.5 4L8 9l4 11 4-11-1.5-5"/>
  {%- when 'sparkle' -%}
    <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M18.5 15.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/>
  {%- when 'star' -%}
    <path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.8l-5.2 2.8 1-5.8L3.5 9.7l5.9-.8z"/>
  {%- when 'check' -%}
    <circle cx="12" cy="12" r="8.5"/><path d="M8.2 12.3l2.6 2.6 5-5.3"/>
  {%- when 'truck' -%}
    <path d="M2.5 6h11v10h-11z"/><path d="M13.5 9.5h4l3 3.2V16h-7"/><circle cx="6.5" cy="17.5" r="1.7"/><circle cx="17" cy="17.5" r="1.7"/>
  {%- when 'exchange' -%}
    <path d="M4 9h14l-3.5-3.5"/><path d="M20 15H6l3.5 3.5"/>
  {%- when 'box' -%}
    <path d="M3.5 7.5L12 3.5l8.5 4v9L12 20.5l-8.5-4z"/><path d="M3.5 7.5L12 11.5l8.5-4"/><path d="M12 11.5v9"/>
  {%- when 'lock' -%}
    <rect x="5" y="10.5" width="14" height="10" rx="1.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>
  {%- when 'ruler' -%}
    <rect x="2.5" y="8" width="19" height="8" rx="1"/><path d="M6.5 8v3M10 8v4.5M13.5 8v3M17 8v4.5"/>
  {%- when 'bag' -%}
    <path d="M5 8h14l-1 12.5H6z"/><path d="M9 10.5V6.5a3 3 0 0 1 6 0v4"/>
  {%- when 'plus' -%}
    <path d="M12 5v14M5 12h14"/>
  {%- when 'minus' -%}
    <path d="M5 12h14"/>
  {%- when 'close' -%}
    <path d="M6 6l12 12M18 6L6 18"/>
  {%- when 'chevron-left' -%}
    <path d="M15 5l-7 7 7 7"/>
  {%- when 'chevron-right' -%}
    <path d="M9 5l7 7-7 7"/>
  {%- when 'play' -%}
    <path d="M8 5.5v13l10-6.5z"/>
  {%- when 'zoom' -%}
    <circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l5 5M10.5 8v5M8 10.5h5"/>
{%- endcase -%}
</svg>
