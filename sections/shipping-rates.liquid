{%- render 'section-spacing', section: section -%}
{%- comment -%}
  Shipping information page: heading, intro text, a sub-heading and a rates table
  (Service | Cost | Delivery time). Each table row is a block. Stacks into cards on mobile.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = '#shopify-section-' | append: section.id
-%}
<style>
  {{ sid }} .ship{ max-width:{{ s.max_width }}px; margin:0 auto; padding:0 20px; color:{{ s.text_color }}; font-family:'Josefin Sans', sans-serif; }
  {{ sid }} .ship__title{ margin:0 0 18px; font-size:clamp(24px,2.4vw,32px); font-weight:400; letter-spacing:.04em; text-transform:uppercase; color:inherit; }
  {{ sid }} .ship__intro{ font-size:15px; line-height:1.9; color:inherit; }
  {{ sid }} .ship__intro p{ margin:0 0 12px; }
  {{ sid }} .ship__subtitle{ margin:28px 0 16px; font-size:clamp(17px,1.5vw,20px); font-weight:400; letter-spacing:.14em; text-transform:uppercase; color:inherit; }
  {{ sid }} .ship__table{ width:100%; border-collapse:collapse; border:1px solid {{ s.border_color }}; font-size:13px; letter-spacing:.02em; }
  {{ sid }} .ship__table th, {{ sid }} .ship__table td{ padding:26px 24px; border:1px solid {{ s.border_color }}; text-align:start; vertical-align:middle; line-height:1.7; color:inherit; }
  {{ sid }} .ship__table th{ font-weight:500; text-transform:uppercase; letter-spacing:.06em; background:{{ s.head_bg }}; }
  {{ sid }} .ship__table td p{ margin:0; }
  {{ sid }} .ship__table td.ship__time{ text-transform:uppercase; }
  {{ sid }} .ship__note{ margin-top:22px; font-size:13px; line-height:1.8; opacity:.85; }
  {{ sid }} .ship__note p{ margin:0 0 8px; }
  @media screen and (max-width:749px){
    {{ sid }} .ship__table thead{ display:none; }
    {{ sid }} .ship__table, {{ sid }} .ship__table tbody, {{ sid }} .ship__table tr, {{ sid }} .ship__table td{ display:block; width:100%; }
    {{ sid }} .ship__table{ border:0; }
    {{ sid }} .ship__table tr{ margin:0 0 14px; border:1px solid {{ s.border_color }}; }
    {{ sid }} .ship__table td{ border:0; border-bottom:1px solid {{ s.border_color }}; padding:14px 16px; }
    {{ sid }} .ship__table td:last-child{ border-bottom:0; }
    {{ sid }} .ship__table td::before{ content:attr(data-label); display:block; margin-bottom:4px; font-size:11px; font-weight:500; letter-spacing:.1em; text-transform:uppercase; opacity:.6; }
  }
</style>

<div class="ship">
  {%- if s.heading != blank -%}<h1 class="ship__title">{{ s.heading | escape }}</h1>{%- endif -%}
  {%- if s.intro != blank -%}<div class="ship__intro">{{ s.intro }}</div>{%- endif -%}
  {%- if s.table_heading != blank -%}<h2 class="ship__subtitle">{{ s.table_heading | escape }}</h2>{%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <table class="ship__table">
      <thead>
        <tr>
          <th scope="col">{{ s.col_service | escape }}</th>
          <th scope="col">{{ s.col_cost | escape }}</th>
          <th scope="col">{{ s.col_time | escape }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          <tr {{ block.shopify_attributes }}>
            <td data-label="{{ s.col_service | escape }}">{{ block.settings.service }}</td>
            <td data-label="{{ s.col_cost | escape }}">{{ block.settings.cost }}</td>
            <td class="ship__time" data-label="{{ s.col_time | escape }}">{{ block.settings.time }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  {%- endif -%}

  {%- if s.note != blank -%}<div class="ship__note">{{ s.note }}</div>{%- endif -%}
</div>

{% schema %}
{
  "name": "Shipping rates",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & delivery" },
    { "type": "richtext", "id": "intro", "label": "Intro text" },
    { "type": "text", "id": "table_heading", "label": "Table heading", "default": "Shipping rates & delivery" },
    { "type": "text", "id": "col_service", "label": "Column 1 title", "default": "Service" },
    { "type": "text", "id": "col_cost", "label": "Column 2 title", "default": "Cost" },
    { "type": "text", "id": "col_time", "label": "Column 3 title", "default": "Delivery time" },
    { "type": "richtext", "id": "note", "label": "Text below the table" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "max_width", "label": "Content width", "min": 600, "max": 1400, "step": 20, "unit": "px", "default": 1100 },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1c1f5a" },
    { "type": "color", "id": "border_color", "label": "Table lines", "default": "#e3e3e3" },
    { "type": "color", "id": "head_bg", "label": "Table header background", "default": "rgba(0,0,0,0)" },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_left", "label": "Margin left", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_right", "label": "Margin right", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_left", "label": "Padding left", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "Padding right", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "spacing_mobile", "label": "Mobile spacing scale", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 70 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Table row",
      "settings": [
        { "type": "inline_richtext", "id": "service", "label": "Service / area", "default": "Dubai, Abu Dhabi, Sharjah" },
        { "type": "richtext", "id": "cost", "label": "Cost", "default": "<p>AED 30</p>" },
        { "type": "inline_richtext", "id": "time", "label": "Delivery time", "default": "1-2 business days" }
      ]
    }
  ],
  "presets": [ { "name": "Shipping rates", "blocks": [ { "type": "row" } ] } ]
}
{% endschema %}
