{%- comment -%}
  Newsletter pop-up (minimalist.ae style): full-screen split panel with an image on one side and
  heading, subheading, email field and button on the other. Signs people up as Shopify customers
  with email marketing consent. Shows once after a delay, then stays hidden for N days after closing or signing up.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign show_success = false
  assign has_error = false
-%}
{%- if s.enable -%}
<div id="NewsletterPopup" class="nlp" role="dialog" aria-modal="true" aria-labelledby="NewsletterPopup-title" hidden
  data-delay="{{ s.delay }}" data-days="{{ s.days }}" data-design-mode="{{ request.design_mode }}">
  <div class="nlp__panel">
    <div class="nlp__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'nlp__img nlp__img--desktop', widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 50vw, 100vw', alt: s.image.alt | default: s.heading }}
        {%- assign m_img = s.image_mobile | default: s.image -%}
        {{ m_img | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'nlp__img nlp__img--mobile', widths: '500, 750, 1000', sizes: '100vw', alt: '' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'nlp__placeholder' }}
      {%- endif -%}
    </div>
    <div class="nlp__body">
      <button type="button" class="nlp__close" aria-label="{{ 'accessibility.close' | t }}" data-nlp-close>
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
      </button>
      <div class="nlp__content">
        {%- if s.logo != blank -%}
          {%- assign logo_style = 'width:' | append: s.logo_width | append: 'px' -%}
          <div class="nlp__logo">
            {{ s.logo | image_url: width: 400 | image_tag: loading: 'lazy', class: 'nlp__logo-img nlp__logo-img--desktop', alt: shop.name, style: logo_style }}
            {%- assign m_logo = s.logo_mobile | default: s.logo -%}
            {{ m_logo | image_url: width: 400 | image_tag: loading: 'lazy', class: 'nlp__logo-img nlp__logo-img--mobile', alt: shop.name, style: logo_style }}
          </div>
        {%- endif -%}
        {%- form 'customer', id: 'NewsletterPopupForm', class: 'nlp__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,popup">
          {%- if form.posted_successfully? -%}{%- assign show_success = true -%}{%- endif -%}
          {%- if form.errors -%}{%- assign has_error = true -%}{%- endif -%}

          {%- if show_success -%}
            <h2 id="NewsletterPopup-title" class="nlp__heading">{{ s.success_heading | escape }}</h2>
            {%- if s.success_text != blank -%}<p class="nlp__sub">{{ s.success_text | escape }}</p>{%- endif -%}
            <button type="button" class="nlp__btn" data-nlp-close>{{ s.success_button | escape }}</button>
          {%- else -%}
            <h2 id="NewsletterPopup-title" class="nlp__heading">{{ s.heading | escape | newline_to_br }}</h2>
            {%- if s.subheading != blank -%}<p class="nlp__sub">{{ s.subheading | escape }}</p>{%- endif -%}
            <label for="NewsletterPopup-email" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
            <div class="nlp__field">
            <svg class="nlp__field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/></svg>
            <input id="NewsletterPopup-email" class="nlp__input" type="email" name="contact[email]" required autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="{{ s.placeholder | escape }}"{% if has_error %} aria-invalid="true" aria-describedby="NewsletterPopup-error"{% endif %}>
            </div>
            {%- if has_error -%}<p id="NewsletterPopup-error" class="nlp__error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
            <button type="submit" class="nlp__btn">{{ s.button_label | escape }}<svg class="nlp__btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg></button>
          {%- endif -%}
        {%- endform -%}
      </div>
      {%- if s.legal != blank and show_success == false -%}<div class="nlp__legal">{{ s.legal }}</div>{%- endif -%}
    </div>
  </div>
</div>

<style>
  .nlp{ position:fixed; inset:0; z-index:2000; display:flex; background:rgba(0,0,0,.45); }
  .nlp[hidden]{ display:none; }
  .nlp__panel{ position:relative; display:grid; grid-template-columns:1fr 1fr; width:100%; height:100%; background:{{ s.panel_bg }}; animation:nlp-in .35s ease; }
  @keyframes nlp-in{ from{ opacity:0; } to{ opacity:1; } }
  .nlp__media{ position:relative; overflow:hidden; background:#efe9e3; }
  .nlp__media img, .nlp__media .nlp__placeholder{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .nlp__img--mobile, .nlp__logo-img--mobile{ display:none !important; }
  .nlp__body{ position:relative; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:60px 40px 32px; color:{{ s.text_color }}; text-align:center; }
  .nlp__close{ position:absolute; top:20px; inset-inline-end:20px; z-index:2; width:44px; height:44px; display:grid; place-items:center; border:0; background:none; color:inherit; cursor:pointer; }
  .nlp__content{ width:100%; max-width:440px; margin:auto 0; }
  .nlp__logo{ display:flex; justify-content:center; margin:0 0 28px; }
  .nlp__logo img{ height:auto; max-width:100%; }
  .nlp__heading{ margin:0 0 14px; font-size:clamp(26px,2.5vw,36px); font-weight:400; line-height:1.15; letter-spacing:.04em; text-transform:uppercase; color:inherit; }
  .nlp__sub{ margin:0 auto 32px; max-width:380px; font-size:15px; line-height:1.55; color:inherit; opacity:.72; }
  .nlp__field{ position:relative; margin:0 0 12px; }
  .nlp__field-icon{ position:absolute; top:50%; inset-inline-start:22px; width:20px; height:20px; transform:translateY(-50%); color:{{ s.button_bg }}; pointer-events:none; }
  .nlp__input{ display:block; width:100%; height:54px; margin:0; padding:0 24px 0 54px; border:1px solid rgba(0,0,0,.08); border-radius:999px; background:{{ s.field_bg }}; color:#1c1f5a; font:inherit; font-size:15px; text-align:start; }
  [dir=rtl] .nlp__input{ padding:0 54px 0 24px; }
  .nlp__input::placeholder{ color:#1c1f5a; opacity:.5; }
  .nlp__input:focus{ outline:none; border-color:{{ s.button_bg }}; }
  .nlp__btn{ display:flex; align-items:center; justify-content:center; gap:12px; width:100%; height:54px; border:0; border-radius:999px; background:{{ s.button_bg }}; color:{{ s.button_text }}; font:inherit; font-size:14px; font-weight:500; letter-spacing:.14em; text-transform:uppercase; cursor:pointer; }
  .nlp__btn-arrow{ width:20px; height:20px; flex:none; }
  [dir=rtl] .nlp__btn-arrow{ transform:scaleX(-1); }
  .nlp__error{ margin:-4px 0 12px; font-size:13px; color:#b3261e; }
  .nlp__legal{ margin-top:24px; font-size:11px; opacity:.7; }
  .nlp__legal p{ margin:0; }
  .nlp__legal a{ color:inherit; text-decoration:underline; }
  html.nlp-open{ overflow:hidden; }

  /* Mobile: full screen, image fills the screen, content sits on top, centred near the top */
  @media (max-width:749px){
    .nlp__panel{ display:block; }
    .nlp__media{ position:absolute; inset:0; }
    .nlp__img--desktop, .nlp__logo-img--desktop{ display:none !important; }
    .nlp__img--mobile, .nlp__logo-img--mobile{ display:block !important; }
    .nlp__media::after{ content:''; position:absolute; inset:0; background:linear-gradient(to bottom, rgba(0,0,0,{{ s.mobile_overlay | divided_by: 100.0 }}) 0%, rgba(0,0,0,0) 65%); }
    .nlp__body{ position:relative; z-index:1; height:100%; justify-content:flex-start; padding:56px 22px 24px; color:{{ s.text_color_mobile }}; background:transparent; overflow-y:auto; }
    .nlp__content{ margin:0; }
    .nlp__logo{ margin-bottom:18px; }
    .nlp__heading{ font-size:28px; margin-bottom:10px; }
    .nlp__sub{ margin-bottom:22px; font-size:14px; opacity:.92; }
    .nlp__input{ background:rgba(255,255,255,.92); border-color:transparent; height:50px; }
    .nlp__btn{ height:50px; }
    .nlp__close{ top:12px; inset-inline-end:12px; }
    .nlp__legal{ margin-top:auto; padding-top:20px; }
  }
/* Brand typography and spacing; #wk-scope beats the theme's own heading/paragraph rules */
  #wk-scope .nlp, #wk-scope .nlp *{ font-family:'Josefin Sans', sans-serif; }
  #wk-scope .nlp__logo{ margin:0 0 32px; }
  #wk-scope .nlp__heading{ margin:0 0 16px; font-size:clamp(22px,1.9vw,28px); font-weight:400; line-height:1.25; letter-spacing:.08em; color:inherit; text-align:center; }
  #wk-scope .nlp__sub{ margin:0 auto 32px; max-width:360px; font-size:15px; line-height:1.6; color:inherit; opacity:.75; text-align:center; }
  #wk-scope .nlp__field{ margin:0 0 14px; }
  #wk-scope .nlp__input{ font-size:15px; letter-spacing:.02em; }
  #wk-scope .nlp__btn{ font-size:14px; letter-spacing:.16em; }
  #wk-scope .nlp__legal{ margin-top:28px; font-size:11px; letter-spacing:.02em; }
  @media (max-width:749px){
    #wk-scope .nlp__logo{ margin-bottom:22px; }
    #wk-scope .nlp__heading{ font-size:22px; margin-bottom:12px; }
    #wk-scope .nlp__sub{ font-size:14px; margin-bottom:24px; }
    #wk-scope .nlp__field{ margin-bottom:12px; }
  }
</style>

<script>
  (() => {
    const el = document.getElementById('NewsletterPopup');
    if (!el || el.dataset.bound) return;
    el.dataset.bound = '1';
    const KEY = 'soleil-newsletter-popup';
    const days = Number(el.dataset.days) || 0;
    const design = el.dataset.designMode === 'true';
    const read = () => { try { return Number(localStorage.getItem(KEY)) || 0; } catch (e) { return 0; } };
    const remember = () => { try { localStorage.setItem(KEY, String(Date.now())); } catch (e) {} };
    const open = () => { el.hidden = false; document.documentElement.classList.add('nlp-open'); el.querySelector('.nlp__input, .nlp__btn')?.focus({ preventScroll: true }); };
    const close = () => { el.hidden = true; document.documentElement.classList.remove('nlp-open'); remember(); };
    el.addEventListener('click', (e) => { if (e.target === el || e.target.closest('[data-nlp-close]')) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !el.hidden) close(); });
    el.querySelector('form')?.addEventListener('submit', remember);

    /* After a sign-up or an error, Shopify reloads the page: show the result straight away. */
    const showResult = {% if show_success or has_error %}true{% else %}false{% endif %};
    const signedUp = {% if show_success %}true{% else %}false{% endif %};
    if (showResult) {
      open();
      if (signedUp) remember();
      return;
    }

    if (design) {
      document.addEventListener('shopify:section:select', (e) => { if (e.target.contains(el)) open(); });
      document.addEventListener('shopify:section:deselect', (e) => { if (e.target.contains(el)) { el.hidden = true; document.documentElement.classList.remove('nlp-open'); } });
      return;
    }
    const last = read();
    if (last && Date.now() - last < days * 86400000) return;
    setTimeout(open, (Number(el.dataset.delay) || 0) * 1000);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Newsletter pop-up",
  "class": "newsletter-popup-section",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Show pop-up", "default": true },
    { "type": "paragraph", "content": "In the theme editor, select this section to preview the pop-up. Sign-ups appear in Customers with email marketing consent and the tag \"newsletter\"." },
    { "type": "range", "id": "delay", "label": "Show after", "min": 0, "max": 30, "step": 1, "unit": "s", "default": 4 },
    { "type": "range", "id": "days", "label": "Hide for this many days after closing", "min": 1, "max": 60, "step": 1, "default": 7 },
    { "type": "header", "content": "Content" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional. Fills the whole screen on phones, with the text on top. Uses the image above when empty." },
    { "type": "image_picker", "id": "logo", "label": "Logo above heading" },
    { "type": "image_picker", "id": "logo_mobile", "label": "Mobile logo", "info": "Optional, e.g. a white version to sit on the photo." },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 40, "max": 300, "step": 5, "unit": "px", "default": 110 },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Join the Soleil list" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Subscribe for new collections, exclusive offers and styling inspiration, straight to your inbox." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "richtext", "id": "legal", "label": "Small print", "default": "<p>By subscribing, you agree to our <a href=\"/policies/terms-of-service\" title=\"Terms\">Terms</a> &amp; <a href=\"/policies/privacy-policy\" title=\"Privacy Policy\">Privacy Policy</a>.</p>" },
    { "type": "header", "content": "After sign-up" },
    { "type": "text", "id": "success_heading", "label": "Heading", "default": "Thank you for subscribing" },
    { "type": "text", "id": "success_text", "label": "Text", "default": "You're on the list. Look out for our latest news and offers in your inbox." },
    { "type": "text", "id": "success_button", "label": "Button label", "default": "Continue shopping" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1c1f5a" },
    { "type": "color", "id": "text_color_mobile", "label": "Text on mobile (over the image)", "default": "#ffffff" },
    { "type": "range", "id": "mobile_overlay", "label": "Mobile image darkening behind text", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "color", "id": "panel_bg", "label": "Panel background", "default": "#f7f8fc" },
    { "type": "color", "id": "field_bg", "label": "Email field background", "default": "#ffffff" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#1c1f5a" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#ffffff" }
  ]
}
{% endschema %}
