{{ 'component-card-soleil.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign collection_1 = section.settings.collection_1
  assign collection_2 = section.settings.collection_2
  assign active = section.settings.default_tab
  capture page_width
    if section.settings.width != 'default'
      echo section.settings.width
    else
      echo 'page-width'
    endif
  endcapture
-%}
<style>
  #theme-section-{{ section.id }}{
    --ct-track: {{ section.settings.color_track }};
    --ct-thumb: {{ section.settings.color_thumb }};
    --ct-active: {{ section.settings.color_active_text }};
    --ct-inactive: {{ section.settings.color_inactive_text }};
  }
  {%- comment -%} custom elements are inline by default, which stopped page-width's max-width applying {%- endcomment -%}
  #theme-section-{{ section.id }} collection-toggle{ display:block; }
  #theme-section-{{ section.id }} .collection-toggle__head{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:20px;
    margin-bottom:32px;
    text-align:center;
  }
  #theme-section-{{ section.id }} .collection-toggle__heading{ margin:0; }
  #theme-section-{{ section.id }} .collection-toggle__switch{
    position:relative;
    display:inline-grid;
    grid-template-columns:1fr 1fr;
    padding:4px;
    border-radius:999px;
    background:var(--ct-track);
  }
  #theme-section-{{ section.id }} .collection-toggle__switch::before{
    content:"";
    position:absolute;
    top:4px;
    bottom:4px;
    left:4px;
    width:calc(50% - 4px);
    border-radius:999px;
    background:var(--ct-thumb);
    box-shadow:0 1px 3px rgba(0,0,0,.12);
    transition:transform .35s cubic-bezier(.3,.7,.2,1);
  }
  #theme-section-{{ section.id }} .collection-toggle__switch[data-active="2"]::before{ transform:translateX(100%); }
  [dir="rtl"] #theme-section-{{ section.id }} .collection-toggle__switch::before{ left:auto; right:4px; }
  [dir="rtl"] #theme-section-{{ section.id }} .collection-toggle__switch[data-active="2"]::before{ transform:translateX(-100%); }
  #theme-section-{{ section.id }} .collection-toggle__btn{
    position:relative;
    z-index:1;
    min-width:120px;
    padding:10px 26px;
    border:0;
    border-radius:999px;
    background:none;
    color:var(--ct-inactive);
    font-family:var(--font-heading-family);
    font-size:14px;
    letter-spacing:.14em;
    text-transform:uppercase;
    white-space:nowrap;
    cursor:pointer;
    transition:color .25s ease;
  }
  #theme-section-{{ section.id }} .collection-toggle__btn[aria-selected="true"]{ color:var(--ct-active); }
  #theme-section-{{ section.id }} .collection-toggle__btn:focus-visible{ outline:2px solid var(--ct-active); outline-offset:2px; }
  #theme-section-{{ section.id }} .collection-toggle__panel[hidden]{ display:none; }
  #theme-section-{{ section.id }} .collection-toggle__panel{ animation:collection-toggle-in .45s ease both; }
  #theme-section-{{ section.id }} .collection-toggle__view-all{ margin-top:4rem; }
  #theme-section-{{ section.id }} .collection-toggle__empty{ padding:40px 0; text-align:center; opacity:.6; }
  @keyframes collection-toggle-in{
    from{ opacity:0; transform:translateY(12px); }
    to{ opacity:1; transform:none; }
  }
  @media (max-width:576px){
    #theme-section-{{ section.id }} .collection-toggle__btn{ min-width:104px; padding:9px 18px; font-size:13px; }
    #theme-section-{{ section.id }} .collection-toggle__head{ margin-bottom:24px; }
  }
  @media (prefers-reduced-motion: reduce){
    #theme-section-{{ section.id }} .collection-toggle__switch::before,
    #theme-section-{{ section.id }} .collection-toggle__panel{ transition:none; animation:none; }
  }
</style>

{%- if collection_1 != blank or collection_2 != blank or request.design_mode -%}
<div id="theme-section-{{ section.id }}"
     class="top-spacing-{{ section.settings.top_spacing }}"
     data-section-name="collection-toggle">
  <collection-toggle class="{{ page_width }}" data-remember="{{ section.settings.remember }}" data-storage-key="collection-toggle-{{ section.id }}">
    <div class="collection-toggle__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="collection-toggle__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="collection-toggle__switch" role="tablist" aria-label="{{ section.settings.label_1 | escape }} / {{ section.settings.label_2 | escape }}" data-active="{{ active }}">
        <button type="button" class="collection-toggle__btn" role="tab" id="ct-tab-1-{{ section.id }}" aria-controls="ct-panel-1-{{ section.id }}" aria-selected="{% if active == '1' %}true{% else %}false{% endif %}" data-toggle="1">{{ section.settings.label_1 | escape }}</button>
        <button type="button" class="collection-toggle__btn" role="tab" id="ct-tab-2-{{ section.id }}" aria-controls="ct-panel-2-{{ section.id }}" aria-selected="{% if active == '2' %}true{% else %}false{% endif %}" data-toggle="2">{{ section.settings.label_2 | escape }}</button>
      </div>
    </div>

    {%- for i in (1..2) -%}
      {%- liquid
        assign index = i | append: ''
        if i == 1
          assign panel_collection = collection_1
        else
          assign panel_collection = collection_2
        endif
      -%}
      <div class="collection-toggle__panel" role="tabpanel" id="ct-panel-{{ i }}-{{ section.id }}" aria-labelledby="ct-tab-{{ i }}-{{ section.id }}" data-panel="{{ i }}" {% if active != index %}hidden{% endif %}>
        {%- if panel_collection != blank and panel_collection.products.size > 0 -%}
          <ul class="grid product-grid grid--{{ section.settings.mobile_grid }}-col-tablet-down grid--{{ section.settings.grid }}-col-desktop" role="list">
            {%- for product in panel_collection.products limit: section.settings.product_limit -%}
              <li class="grid__item">
                {%- render 'card-product-soleil',
                  card_product: product,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  show_type: section.settings.show_type,
                  show_rating: section.settings.show_rating,
                  show_description: section.settings.show_description
                -%}
              </li>
            {%- endfor -%}
          </ul>
          {%- if section.settings.link_name != blank -%}
            <div class="center collection-toggle__view-all">
              <a href="{{ panel_collection.url }}" class="button">{{ section.settings.link_name | escape }}</a>
            </div>
          {%- endif -%}
        {%- elsif request.design_mode -%}
          <p class="collection-toggle__empty">
            {%- if panel_collection == blank -%}Select a collection for this side of the toggle.{%- else -%}This collection has no products yet.{%- endif -%}
          </p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </collection-toggle>
</div>

<script>
if (!customElements.get('collection-toggle')) {
  customElements.define('collection-toggle', class extends HTMLElement {
    connectedCallback() {
      // A second toggle on the page is created while the HTML is still being parsed,
      // before its buttons exist; wait for the document to finish parsing first.
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => this.init(), { once: true });
      } else {
        this.init();
      }
    }
    init() {
      // the theme editor can re-insert a section; only wire it up once
      if (this.initialized) return;
      this.switchEl = this.querySelector('.collection-toggle__switch');
      if (!this.switchEl) return;
      this.initialized = true;
      this.remember = this.dataset.remember === 'true';
      // one saved choice per section, so duplicated toggles don't override each other
      this.storageKey = this.dataset.storageKey || 'collection-toggle';
      this.switchEl.addEventListener('click', (event) => {
        const btn = event.target.closest('[data-toggle]');
        if (btn && this.switchEl.contains(btn)) this.select(btn.dataset.toggle, true);
      });
      this.switchEl.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        const next = this.switchEl.dataset.active === '1' ? '2' : '1';
        this.select(next, true);
        const nextBtn = this.switchEl.querySelector('[data-toggle="' + next + '"]');
        if (nextBtn) nextBtn.focus();
      });
      if (this.remember && !(window.Shopify && Shopify.designMode)) {
        try {
          const saved = localStorage.getItem(this.storageKey);
          if (saved === '1' || saved === '2') this.select(saved, false);
        } catch (e) {}
      }
    }
    select(value, save) {
      this.switchEl.dataset.active = value;
      this.switchEl.querySelectorAll('[data-toggle]').forEach((btn) => {
        const on = btn.dataset.toggle === value;
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
        btn.tabIndex = on ? 0 : -1;
      });
      // only this section's panels (direct children), never a nested/duplicated toggle's
      Array.from(this.children).filter((el) => el.matches('[data-panel]')).forEach((panel) => {
        panel.hidden = panel.dataset.panel !== value;
      });
      if (save && this.remember) {
        try { localStorage.setItem(this.storageKey, value); } catch (e) {}
      }
    }
  });
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Women / Men toggle",
  "tag": "section",
  "class": "section-collection-toggle",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.popups"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Toggle"
    },
    {
      "type": "text",
      "id": "label_1",
      "label": "First label",
      "default": "Womens"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "First collection"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Second label",
      "default": "Mens"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Second collection"
    },
    {
      "type": "select",
      "id": "default_tab",
      "label": "Selected by default",
      "options": [
        {
          "value": "1",
          "label": "First"
        },
        {
          "value": "2",
          "label": "Second"
        }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "remember",
      "label": "Remember the visitor's last choice",
      "default": true
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h2",
          "label": "Large"
        },
        {
          "value": "h3",
          "label": "Medium"
        },
        {
          "value": "h4",
          "label": "Small"
        }
      ],
      "default": "h3"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "grid",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_grid",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_type",
      "label": "Show product type",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show short description",
      "info": "Uses the product's small description metafield, when set",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "text",
      "id": "link_name",
      "label": "View all button label",
      "info": "Leave empty to hide the button.",
      "default": "View all"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_track",
      "label": "Toggle background",
      "default": "#ececf1"
    },
    {
      "type": "color",
      "id": "color_thumb",
      "label": "Selected pill",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_active_text",
      "label": "Selected text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_inactive_text",
      "label": "Unselected text",
      "default": "#a3a3ad"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Top spacing",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "normal",
          "label": "Normal"
        }
      ],
      "default": "normal"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "page-width",
          "label": "Content width"
        }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Women / Men toggle"
    }
  ]
}
{% endschema %}
