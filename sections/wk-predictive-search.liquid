{%- comment -%}
  Live search results for the header search (fetched by assets/wk-predictive-search.js while typing).
  Layout follows minimalist.ae: suggestions, a grid of product cards (image, title, price), then "View all results".
{%- endcomment -%}
{%- liquid
  assign ps = predictive_search
  assign products = ps.resources.products
  assign suggestions_size = ps.resources.queries.size | plus: ps.resources.collections.size
  assign total = products.size | plus: suggestions_size | plus: ps.resources.pages.size
-%}
<style>
  #wk-scope wk-predictive-search .predictive-search-container:has(.sps){ min-width:min(760px, calc(100vw - 32px)); left:auto; right:0; padding:0; max-height:80vh; overflow-y:auto; background:#fff; }
  #wk-scope .sps *, #wk-scope .sps a{ color:#1c1f5a; }
  #wk-scope .sps .sps__all, #wk-scope .sps .sps__all *{ color:#fff; }
  /* Reset theme predictive-search item styles so every search panel (header, popup, mobile) looks the same */
  #wk-scope .sps .predictive-search__item, .sps .predictive-search__item{ width:auto; padding:0 !important; font-family:inherit; font-size:inherit; font-weight:inherit; line-height:inherit; }
  #wk-scope .sps .predictive-search__item:before, .sps .predictive-search__item:before{ display:none; }
  #wk-scope .sps .predictive-search__list-item, .sps .predictive-search__list-item{ padding:0; margin:0; }
  #wk-scope .sps .sps__suggest a.predictive-search__item, .sps .sps__suggest a{ display:inline-block; padding:6px 14px !important; font-size:13px; line-height:1.3; }
  #wk-scope .sps .sps__card, .sps .sps__card{ display:flex; flex-direction:column; width:100%; }
  #wk-scope .sps .sps__all, .sps .sps__all{ padding:0 16px !important; font-size:13px; }
  .sps__heading{ font-size:13px !important; font-weight:500; line-height:1.3; }
  .sps__title{ min-height:2.7em; }
  .sps__price{ line-height:1.3; }
  #wk-scope .sps ul, .sps ul{ padding:0 !important; margin-left:0 !important; margin-right:0 !important; }
  .sps__all-wrap{ display:flex; justify-content:center; margin-top:22px; }
  #wk-scope .sps a, #wk-scope .sps a:hover, .sps a:hover{ text-decoration:none !important; opacity:1 !important; }
  #wk-scope .sps .sps__card:hover .sps__img img{ transform:none !important; }
  .sps{ width:100%; padding:20px 24px 24px; background:#fff; color:#1c1f5a; text-align:start; }
  .sps__heading{ margin:0 0 12px; padding:0 0 8px; border-bottom:1px solid currentColor; font-size:13px; letter-spacing:.12em; text-transform:uppercase; }
  .sps__suggest{ display:flex; flex-wrap:wrap; gap:8px; margin:0 0 22px; padding:0; list-style:none; }
  .sps__suggest a{ display:inline-block; padding:6px 14px; border:1px solid rgba(0,0,0,.15); border-radius:999px; font-size:13px; color:inherit; text-decoration:none; }
  
  .sps__suggest mark{ background:none; color:inherit; font-weight:600; }
  .sps__grid{ display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:20px 16px; margin:0; padding:0; list-style:none; }
  .sps__card{ display:block; color:inherit; text-decoration:none; }
  .sps__img{ position:relative; aspect-ratio:1/1; overflow:hidden; background:#f6f5f3; }
  .sps__img img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  
  .sps__title{ margin:10px 0 4px; font-size:13px; line-height:1.35; letter-spacing:.04em; text-transform:uppercase; }
  .sps__price{ font-size:13px; }
  .sps__price s{ opacity:.55; margin-inline-end:6px; }
  .sps__empty{ margin:0; padding:8px 0; font-size:14px; }
  .sps__all{ display:flex; align-items:center; justify-content:center; gap:10px; width:100%; max-width:420px; min-height:46px; background:#1c1f5a; color:#fff; font-size:13px; letter-spacing:.12em; text-transform:uppercase; text-decoration:none; border:0; cursor:pointer; }
  
  /* Desktop page-level panel (created by wk-predictive-search.js, attached to <body>) */
  .sp-panel{ position:fixed; inset:0; z-index:1000; }
  .sp-panel[hidden]{ display:none; }
  .sp-panel__dim{ position:absolute; inset:var(--sp-top, 0) 0 0 0; background:rgba(0,0,0,.25); }
  .sp-panel__box{ position:absolute; top:var(--sp-top, 0); left:0; right:0; max-height:calc(100vh - var(--sp-top, 0px) - 24px); overflow-y:auto; background:#fff; box-shadow:0 12px 30px rgba(0,0,0,.12); }
  .sp-panel__inner{ max-width:1400px; margin:0 auto; }
  .sp-panel .sps{ padding:28px 40px 32px; }
  .sp-panel .sps__grid{ grid-template-columns:repeat(6,minmax(0,1fr)); gap:24px 20px; }
  
  .sp-panel__close{ position:absolute; top:10px; right:16px; z-index:1; width:36px; height:36px; border:0; background:none; font-size:28px; line-height:1; color:#1c1f5a; cursor:pointer; }
  [dir=rtl] .sp-panel__close{ right:auto; left:16px; }
  .sp-panel .sps, .sp-panel .sps *, .sp-panel .sps a{ color:#1c1f5a; }
  .sp-panel .sps .sps__all, .sp-panel .sps .sps__all *{ color:#fff; }
  .sp-panel .predictive-search__list-item[aria-selected="true"] .sps__card .sps__title{ text-decoration:underline; }
  .sp-panel .sps__suggest [aria-selected="true"] a{ border-color:#1c1f5a; }
  @media (min-width:750px) and (max-width:1024px){ .sps__grid li:nth-child(n+5){ display:none; } }
  @media (max-width:749px){
    .sps__grid li:nth-child(n+5){ display:none; }
    .sps{ padding:16px; }
    .sps__grid{ gap:18px 12px; }
    .sps__title{ margin-top:8px; font-size:12px; }
    .sps__price{ font-size:12px; }
    .sps__suggest{ margin-bottom:18px; }
    .sps__grid{ grid-template-columns:repeat(2,minmax(0,1fr)); }
  }
</style>

<div id="predictive-search-results" class="sps" role="listbox">
  {%- if ps.performed -%}
    {%- if suggestions_size > 0 -%}
      <p class="sps__heading">{{ 'templates.search.suggestions' | t }}</p>
      <ul class="sps__suggest" role="group">
        {%- for query in ps.resources.queries limit: 5 -%}
          <li class="predictive-search__list-item" role="option" aria-selected="false"><a href="{{ query.url }}" class="predictive-search__item" tabindex="-1">{{ query.styled_text }}</a></li>
        {%- endfor -%}
        {%- for collection in ps.resources.collections limit: 3 -%}
          <li class="predictive-search__list-item" role="option" aria-selected="false"><a href="{{ collection.url }}" class="predictive-search__item" tabindex="-1">{{ collection.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if products.size > 0 -%}
      <p class="sps__heading">{{ 'templates.search.products' | t | default: 'Products' }}</p>
      <ul id="predictive-search-results-list" class="sps__grid" role="group">
        {%- for product in products limit: 6 -%}
          <li class="predictive-search__list-item" role="option" aria-selected="false">
            <a href="{{ product.url }}" class="sps__card predictive-search__item" tabindex="-1">
              <div class="sps__img">
                {%- if product.featured_media -%}
                  <img src="{{ product.featured_media | image_url: width: 400 }}" srcset="{{ product.featured_media | image_url: width: 300 }} 300w, {{ product.featured_media | image_url: width: 500 }} 500w" sizes="(min-width: 750px) 180px, 45vw" alt="{{ product.featured_media.alt | default: product.title | escape }}" width="400" height="400" loading="eager">
                {%- endif -%}
              </div>
              <p class="sps__title">{{ product.title | escape }}</p>
              <div class="sps__price">
                {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
                {%- if product.price_varies -%}{{ 'products.product.price.from_price_html' | t: price: '' }}{%- endif -%}{{ product.price | money }}
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if total == 0 -%}
      <p class="sps__empty">{{ 'templates.search.no_results' | t: terms: ps.terms }}</p>
    {%- endif -%}

    <div id="predictive-search-option-search-keywords" class="sps__all-wrap" role="option" aria-selected="false">
      <a href="{{ routes.search_url }}?q={{ ps.terms | url_encode }}&amp;options%5Bprefix%5D=last" class="sps__all">
        {%- if products.size > 0 -%}View all results{%- else -%}{{ 'templates.search.search_for' | t: terms: ps.terms }}{%- endif -%}
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <span class="hidden" data-predictive-search-live-region-count-value>
      {%- if total == 0 -%}{{ 'templates.search.no_results' | t: terms: ps.terms }}{%- else -%}{{ 'templates.search.results_with_count' | t: count: total }}{%- endif -%}
    </span>
  {%- endif -%}
</div>
