{%- comment -%}
  Full-width collection banner, as on minimalist.ae/collections/perfumes: the image spans the page at its
  natural proportions with no overlay. Image priority: the collection metafield custom.bg-image (file, image),
  then the section override, then the collection image.
  Renders nothing when the collection has no image, so the page starts at the toolbar.
  The page h1 lives in the product grid section.
{%- endcomment -%}
{%- liquid
  assign meta_image = collection.metafields.custom['bg-image'].value | default: collection.metafields.custom.bg_image.value
  assign desktop_image = meta_image | default: section.settings.image_desktop | default: collection.image
  assign mobile_image = desktop_image
  if meta_image == blank and section.settings.image_mobile != blank
    assign mobile_image = section.settings.image_mobile
  endif
-%}
{%- if desktop_image != blank -%}
  <style>
    #shopify-section-{{ section.id }} .collection-banner-image{ position:relative; margin-bottom:{{ section.settings.margin_bottom }}px; }
    #shopify-section-{{ section.id }} .collection-banner-image img{ display:block; width:100%; height:auto; }
    #shopify-section-{{ section.id }} .collection-banner-image__mobile{ display:none; }
    {%- if section.settings.max_height > 0 -%}
    #shopify-section-{{ section.id }} .collection-banner-image img{ max-height:{{ section.settings.max_height }}px; object-fit:cover; }
    {%- endif -%}
    @media screen and (max-width:640px){
      #shopify-section-{{ section.id }} .collection-banner-image__desktop{ display:none; }
      #shopify-section-{{ section.id }} .collection-banner-image__mobile{ display:block; }
    }
  </style>

  <div class="collection-banner-image">
    {{
      desktop_image
      | image_url: width: 2800
      | image_tag:
        class: 'collection-banner-image__desktop',
        loading: 'eager',
        fetchpriority: 'high',
        widths: '832, 1200, 1920, 2400, 2800',
        sizes: '100vw',
        alt: collection.title
    }}
    {{
      mobile_image
      | image_url: width: 1200
      | image_tag:
        class: 'collection-banner-image__mobile',
        loading: 'eager',
        widths: '500, 750, 1000, 1200',
        sizes: '100vw',
        alt: collection.title
    }}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection banner image",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows each collection's banner full width: the collection metafield custom.bg-image if set, otherwise the collection image. Collections without either show no banner."
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop banner override",
      "info": "Optional. Used when a collection has no bg-image metafield. Leave empty to use each collection's own image."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile banner override",
      "info": "Optional. Defaults to the desktop image."
    },
    {
      "type": "range",
      "id": "max_height",
      "min": 0,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Maximum height",
      "info": "0 shows the full image at its natural size.",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Space below banner",
      "default": 0
    }
  ]
}
{% endschema %}
