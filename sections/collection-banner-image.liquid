{%- comment -%}
  Full-width collection banner, as on minimalist.ae/collections/perfumes: the image spans the page at its
  natural proportions with no overlay. The image comes only from the collection metafield custom.bg-image
  (file, image). Renders nothing when the metafield is empty, so the page starts at the toolbar.
  The page h1 lives in the product grid section.
{%- endcomment -%}
{%- assign banner_image = collection.metafields.custom['bg-image'].value -%}
{%- if banner_image != blank -%}
  <style>
    #shopify-section-{{ section.id }} .collection-banner-image{ position:relative; margin-bottom:{{ section.settings.margin_bottom }}px; }
    #shopify-section-{{ section.id }} .collection-banner-image__img{ display:block; width:100%; height:auto; object-fit:cover; }
    {%- if section.settings.max_height > 0 %}
    @media screen and (min-width:750px){ #shopify-section-{{ section.id }} .collection-banner-image__img{ max-height:{{ section.settings.max_height }}px; } }
    {%- endif %}
    {%- if section.settings.max_height_mobile > 0 %}
    @media screen and (max-width:749px){ #shopify-section-{{ section.id }} .collection-banner-image__img{ max-height:{{ section.settings.max_height_mobile }}px; } }
    {%- endif %}
  </style>

  <div class="collection-banner-image">
    {{
      banner_image
      | image_url: width: 2800
      | image_tag:
        class: 'collection-banner-image__img',
        loading: 'eager',
        fetchpriority: 'high',
        widths: '500, 750, 1000, 1200, 1920, 2400, 2800',
        sizes: '100vw',
        alt: collection.title
    }}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection banner image",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the image from each collection's bg-image metafield (custom.bg-image) full width. Collections without it show no banner."
    },
    {
      "type": "range",
      "id": "max_height",
      "min": 0,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Maximum height (desktop)",
      "info": "0 shows the full image at its natural size.",
      "default": 0
    },
    {
      "type": "range",
      "id": "max_height_mobile",
      "min": 0,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Maximum height (mobile)",
      "info": "Below 750px wide. 0 shows the full image at its natural size.",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Space below banner",
      "default": 0
    }
  ]
}
{% endschema %}
