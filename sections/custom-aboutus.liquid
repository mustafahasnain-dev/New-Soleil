{%- liquid
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image
  assign ratio = 2.03
  if image != blank
    assign ratio = image.aspect_ratio
  endif
  capture page_width
    if section.settings.width == 'default'
      echo 'page-width'
    elsif section.settings.width != 'full'
      echo section.settings.width
    endif
  endcapture
-%}
<style>
  #theme-section-{{ section.id }}{
    --about-text: {{ section.settings.color_text }};
    --about-bg: {{ section.settings.color_background }};
    --about-btn: {{ section.settings.color_button }};
    --about-btn-text: {{ section.settings.color_button_text }};
    --about-radius: {{ section.settings.border_radius }}px;
  }
  #theme-section-{{ section.id }} .custom-aboutus{
    position:relative;
    display:flex;
    flex-direction:column;
    overflow:hidden;
    border-radius:var(--about-radius);
    background:var(--about-bg);
    color:var(--about-text);
  }
  #theme-section-{{ section.id }} .custom-aboutus__media{
    position:relative;
    aspect-ratio:{{ section.settings.mobile_ratio }};
    overflow:hidden;
  }
  #theme-section-{{ section.id }} .custom-aboutus__media img,
  #theme-section-{{ section.id }} .custom-aboutus__media svg{
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:{{ section.settings.mobile_focus }} center;
  }
  #theme-section-{{ section.id }} .custom-aboutus__content{
    position:relative;
    padding:36px 24px 44px;
    text-align:center;
  }
  #theme-section-{{ section.id }} .custom-aboutus__subheading{
    margin:0 0 10px;
    font-size:13px;
    letter-spacing:.04em;
  }
  #theme-section-{{ section.id }} .custom-aboutus__heading{
    margin:0;
    color:inherit;
    font-family:var(--font-heading-family);
    font-style:var(--font-heading-style);
    font-weight:var(--font-heading-weight);
    font-size:clamp(30px, 3.4vw, 56px);
    line-height:1.15;
  }
  #theme-section-{{ section.id }} .custom-aboutus__text{
    margin-top:18px;
    font-size:clamp(14px, 1.05vw, 17px);
    line-height:1.65;
  }
  #theme-section-{{ section.id }} .custom-aboutus__text > :first-child{ margin-top:0; }
  #theme-section-{{ section.id }} .custom-aboutus__text > :last-child{ margin-bottom:0; }
  #theme-section-{{ section.id }} .custom-aboutus__btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:18px;
    margin-top:28px;
    min-height:48px;
    padding:0 28px;
    border:1px solid var(--about-btn);
    background:var(--about-btn);
    color:var(--about-btn-text);
    font-size:12px;
    font-weight:var(--font-button-weight, 500);
    letter-spacing:.2em;
    text-transform:uppercase;
    text-decoration:none;
    transition:background .25s ease, color .25s ease;
  }
  #theme-section-{{ section.id }} .custom-aboutus__btn svg{
    width:22px;
    height:10px;
    transition:transform .25s ease;
  }
  #theme-section-{{ section.id }} .custom-aboutus__btn:hover{
    background:transparent;
    color:var(--about-btn);
  }
  #theme-section-{{ section.id }} .custom-aboutus__btn:hover svg{ transform:translateX(5px); }

  @media (min-width:990px){
    #theme-section-{{ section.id }} .custom-aboutus{
      display:block;
      aspect-ratio:{{ ratio }};
      min-height:{{ section.settings.min_height }}px;
    }
    #theme-section-{{ section.id }} .custom-aboutus__media{
      position:absolute;
      inset:0;
      aspect-ratio:auto;
    }
    #theme-section-{{ section.id }} .custom-aboutus__media img,
    #theme-section-{{ section.id }} .custom-aboutus__media svg{ object-position:center; }
    #theme-section-{{ section.id }} .custom-aboutus__content{
      position:absolute;
      top:50%;
      {% if section.settings.text_position == 'right' %}left{% else %}right{% endif %}:{{ section.settings.content_offset }}%;
      width:{{ section.settings.content_width }}%;
      padding:0;
      text-align:{% if section.settings.text_position == 'right' %}left{% else %}right{% endif %};
      transform:translateY(-50%);
    }
  }

  /* Reveal */
  #theme-section-{{ section.id }} .custom-aboutus__content > *{
    opacity:0;
    transform:translateY(18px);
    transition:opacity .8s cubic-bezier(.2,.7,.2,1), transform .8s cubic-bezier(.2,.7,.2,1);
  }
  #theme-section-{{ section.id }} .custom-aboutus__content > :nth-child(2){ transition-delay:.08s; }
  #theme-section-{{ section.id }} .custom-aboutus__content > :nth-child(3){ transition-delay:.16s; }
  #theme-section-{{ section.id }} .custom-aboutus__content > :nth-child(4){ transition-delay:.24s; }
  #theme-section-{{ section.id }} .custom-aboutus.is-in .custom-aboutus__content > *{
    opacity:1;
    transform:none;
  }
  @media (prefers-reduced-motion: reduce){
    #theme-section-{{ section.id }} .custom-aboutus__content > *{ opacity:1; transform:none; transition:none; }
  }
</style>

<div id="theme-section-{{ section.id }}"
     class="top-spacing-{{ section.settings.top_spacing }}{% if page_width != blank %} {{ page_width }}{% endif %}"
     data-section-name="custom-aboutus">
  <div class="custom-aboutus">
    <div class="custom-aboutus__media">
      {%- if image != blank -%}
        <picture>
          <source
            media="(max-width: 989px)"
            srcset="{{ image_mobile | image_url: width: 600 }} 600w, {{ image_mobile | image_url: width: 900 }} 900w, {{ image_mobile | image_url: width: 1400 }} 1400w"
            sizes="100vw">
          <img
            src="{{ image | image_url: width: 1920 }}"
            srcset="{{ image | image_url: width: 1100 }} 1100w, {{ image | image_url: width: 1500 }} 1500w, {{ image | image_url: width: 1920 }} 1920w, {{ image | image_url: width: 2560 }} 2560w"
            sizes="100vw"
            width="{{ image.width }}"
            height="{{ image.height }}"
            alt="{{ image.alt | default: section.settings.heading | escape }}"
            loading="lazy">
        </picture>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="custom-aboutus__content">
      {%- if section.settings.subheading != blank -%}
        <p class="custom-aboutus__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="custom-aboutus__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="custom-aboutus__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div>
          <a class="custom-aboutus__btn"{% if section.settings.button_link != blank %} href="{{ section.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>
            <span>{{ section.settings.button_label | escape }}</span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true" focusable="false"><path d="M0 5h21M17 1l4 4-4 4"/></svg>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var el = document.querySelector('#theme-section-{{ section.id }} .custom-aboutus');
    if (!el) return;
    if (!('IntersectionObserver' in window)) { el.classList.add('is-in'); return; }
    var io = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting) { el.classList.add('is-in'); io.disconnect(); }
    }, { threshold: 0.2 });
    io.observe(el);
  })();
</script>

{% schema %}
{
  "name": "Custom about us",
  "tag": "section",
  "class": "section-custom-aboutus",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.popups"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. On mobile the image sits above the text."
    },
    {
      "type": "select",
      "id": "mobile_ratio",
      "label": "Mobile image shape",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 3",
          "label": "Landscape"
        },
        {
          "value": "3 / 4",
          "label": "Portrait"
        }
      ],
      "default": "4 / 3"
    },
    {
      "type": "select",
      "id": "mobile_focus",
      "label": "Mobile image focus",
      "info": "Which part of the image stays visible when it is cropped on mobile.",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "25%",
          "label": "Left of centre"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "25%"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Jewellery with a story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About SOLEIL"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>At SOLEIL, we create jewellery that celebrates timeless elegance, individuality and meaningful moments. Inspired by beauty, culture and the world around us, each piece is thoughtfully designed to bring a refined touch to everyday life and special occasions.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover Soleil"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text side",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "content_offset",
      "label": "Text distance from the opposite edge",
      "min": 5,
      "max": 75,
      "step": 1,
      "unit": "%",
      "default": 61
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Text width",
      "min": 20,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 29
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 460
    },
    {
      "type": "select",
      "id": "width",
      "label": "Section width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "default",
          "label": "Default"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "top_spacing",
      "label": "Top spacing",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "normal",
          "label": "Normal"
        }
      ],
      "default": "normal"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Text",
      "default": "#202259"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "info": "Shown behind the text on mobile.",
      "default": "#f6efe6"
    },
    {
      "type": "color",
      "id": "color_button",
      "label": "Button",
      "default": "#202259"
    },
    {
      "type": "color",
      "id": "color_button_text",
      "label": "Button text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Custom about us"
    }
  ]
}
{% endschema %}
