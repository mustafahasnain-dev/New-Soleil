{%- comment -%}
  Curated collections: a centred heading over a row of rounded collection tiles with an uppercase label underneath.
  Each block picks a collection; the tile uses the block image, else the collection image, else its first product image.
{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} .curated-collections{
    padding-top:{{ section.settings.padding_top }}px;
    padding-bottom:{{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .curated-collections__heading{
    margin:0 0 {{ section.settings.heading_gap }}px;
    text-align:center;
    text-transform:uppercase;
    letter-spacing:.02em;
    font-size:{{ section.settings.heading_size }}px;
    line-height:1.2;
  }
  #shopify-section-{{ section.id }} .curated-collections__grid{
    display:grid;
    grid-template-columns:repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap:{{ section.settings.gap }}px;
    margin:0;
    padding:0;
    list-style:none;
  }
  #shopify-section-{{ section.id }} .curated-collections__item a{
    display:block;
    color:inherit;
    text-decoration:none;
  }
  #shopify-section-{{ section.id }} .curated-collections__media{
    position:relative;
    display:block;
    aspect-ratio:{{ section.settings.image_ratio }};
    overflow:hidden;
    border-radius:{{ section.settings.radius }}px;
    background:rgba(var(--color-foreground), .05);
  }
  #shopify-section-{{ section.id }} .curated-collections__media img,
  #shopify-section-{{ section.id }} .curated-collections__media svg{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    transition:transform .8s cubic-bezier(.2,.6,.2,1);
  }
  @media (hover:hover){
    #shopify-section-{{ section.id }} .curated-collections__item a:hover .curated-collections__media img{ transform:scale(1.05); }
    #shopify-section-{{ section.id }} .curated-collections__item a:hover .curated-collections__label{ text-decoration:underline; text-underline-offset:4px; }
  }
  #shopify-section-{{ section.id }} .curated-collections__label{
    display:block;
    margin-top:18px;
    text-align:center;
    text-transform:uppercase;
    letter-spacing:.04em;
    font-size:{{ section.settings.label_size }}px;
    line-height:1.3;
  }
  @media screen and (max-width:989px){
    #shopify-section-{{ section.id }} .curated-collections__grid{ grid-template-columns:repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (max-width:749px){
    #shopify-section-{{ section.id }} .curated-collections__heading{ font-size:{{ section.settings.heading_size | times: 0.8 | round }}px; }
    #shopify-section-{{ section.id }} .curated-collections__grid{
      {%- if section.settings.mobile_layout == 'slider' -%}
      display:flex;
      overflow-x:auto;
      scroll-snap-type:x mandatory;
      scrollbar-width:none;
      gap:12px;
      {%- else -%}
      gap:12px;
      {%- endif -%}
    }
    {%- if section.settings.mobile_layout == 'slider' -%}
    #shopify-section-{{ section.id }} .curated-collections__grid::-webkit-scrollbar{ display:none; }
    #shopify-section-{{ section.id }} .curated-collections__item{ flex:0 0 72%; scroll-snap-align:start; }
    {%- endif -%}
    #shopify-section-{{ section.id }} .curated-collections__label{ margin-top:12px; font-size:{{ section.settings.label_size | minus: 2 }}px; }
  }
  @media (prefers-reduced-motion: reduce){
    #shopify-section-{{ section.id }} .curated-collections__media img{ transition:none; }
  }
</style>

<div class="curated-collections">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="curated-collections__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="curated-collections__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign tile_image = block.settings.image
          if tile_image == blank and col != blank
            assign tile_image = col.featured_image
          endif
          assign label = block.settings.label
          if label == blank and col != blank
            assign label = col.title
          endif
          assign tile_url = col.url | default: routes.collections_url
        -%}
        <li class="curated-collections__item" {{ block.shopify_attributes }}>
          <a href="{{ tile_url }}">
            <span class="curated-collections__media">
              {%- if tile_image != blank -%}
                {{
                  tile_image
                  | image_url: width: 1100
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 900, 1100',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 72vw',
                    alt: label
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
            </span>
            {%- if label != blank -%}
              <span class="curated-collections__label">{{ label | escape }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Shop by category",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_gap",
      "min": 8,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Space below heading",
      "default": 32
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "0.857", "label": "Portrait (like reference)" },
        { "value": "0.75", "label": "Tall portrait (3:4)" },
        { "value": "1", "label": "Square" }
      ],
      "default": "0.857"
    },
    {
      "type": "range",
      "id": "radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Image corner radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "gap",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Space between tiles",
      "default": 22
    },
    {
      "type": "range",
      "id": "label_size",
      "min": 11,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Label size",
      "default": 16
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "grid", "label": "2-column grid" },
        { "value": "slider", "label": "Swipe slider" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Defaults to the collection image."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Optional. Defaults to the collection title."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
