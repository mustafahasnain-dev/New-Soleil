<script type="application/ld+json">
  {{ product | structured_data }}
</script>
{{ 'section-main-product-custom.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'main-product-custom.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'mpc-form-' | append: section.id
  assign installment_count = 4
  for block in section.blocks
    if block.type == 'installments'
      assign installment_count = block.settings.count
    endif
  endfor
  assign accent = section.settings.accent_color
  assign tab_blocks = section.blocks | where: 'type', 'collapsible_tab'
  assign single_variant = false
  if product.has_only_default_variant
    assign single_variant = true
  endif
-%}

<style>
  #mpc-{{ section.id }} {
    --mpc-accent: {{ accent }};
    --mpc-accent-text: {{ section.settings.accent_text_color }};
    --mpc-muted-bg: {{ section.settings.muted_bg }};
    --mpc-line: {{ section.settings.line_color }};
    --mpc-info-width: {{ section.settings.info_width }}%;
    --mpc-thumb-radius: {% if section.settings.thumb_shape == 'circle' %}50%{% else %}4px{% endif %};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media (min-width: 990px) {
    #mpc-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .reveal-fade{
    opacity:0;
    transform:translateY(18px);
    transition:opacity .7s cubic-bezier(.4,0,.2,1), transform .7s cubic-bezier(.4,0,.2,1);
  }
  .reveal-fade.is-visible{
    opacity:1;
    transform:translateY(0);
  }
  @media (prefers-reduced-motion: reduce){
    .reveal-fade{
      transition:none !important;
      opacity:1 !important;
      transform:none !important;
    }
  }
</style>

<main-product-custom
  id="mpc-{{ section.id }}"
  class="mpc{% if section.settings.gallery_position == 'right' %} mpc--flip{% endif %}"
  data-section="{{ section.id }}"
  data-url="{{ product.url }}"
  data-form-id="{{ form_id }}"
>
  <div class="mpc__container page-width">
    <div class="mpc__grid reveal-fade{% if tab_blocks.size == 0 %} mpc__grid--no-tabs{% endif %}">

      {%- comment -%} ============ MEDIA GALLERY ============ {%- endcomment -%}
      <div class="mpc__media">
        {%- if product.media.size > 0 -%}
          <div class="mpc-gallery mpc-gallery--{{ section.settings.image_ratio }}" data-mpc-gallery>
            {%- if product.media.size > 1 -%}
              <div class="mpc-gallery__thumbs{% if section.settings.hide_thumbs_mobile %} mpc-hide-mobile{% endif %}" role="tablist" aria-label="{{ 'products.product.media.gallery_viewer' | t }}">
                {%- for media in product.media -%}
                  <button
                    type="button"
                    class="mpc-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                    data-index="{{ forloop.index0 }}"
                    aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
                    {% if forloop.first %}aria-current="true"{% endif %}
                  >
                    {{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: media.alt, widths: '90,180' }}
                    {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                      <span class="mpc-gallery__thumb-badge">{% render 'mpc-icon', name: 'play' %}</span>
                    {%- endif -%}
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}

            <div class="mpc-gallery__main">
              <div class="mpc-gallery__track" data-mpc-track tabindex="0" aria-label="{{ product.title | escape }}">
                {%- for media in product.media -%}
                  <div class="mpc-gallery__slide" data-media-id="{{ media.id }}" data-index="{{ forloop.index0 }}">
                    {%- case media.media_type -%}
                      {%- when 'image' -%}
                        <button type="button" class="mpc-gallery__zoom" data-mpc-zoom="{{ forloop.index0 }}" aria-label="{{ 'products.product.media.open_media' | t: index: forloop.index }}">
                          {%- if forloop.first -%}
                            {{ media | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 55vw, 100vw', widths: '400,600,800,1000,1200,1500,1800', alt: media.alt }}
                          {%- else -%}
                            {{ media | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 55vw, 100vw', widths: '400,600,800,1000,1200,1500,1800', alt: media.alt }}
                          {%- endif -%}
                        </button>
                      {%- when 'video' -%}
                        {{ media | video_tag: controls: true, playsinline: true, muted: true, loop: true, image_size: '1200x' }}
                      {%- when 'external_video' -%}
                        {{ media | external_video_tag }}
                      {%- when 'model' -%}
                        {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true }}
                    {%- endcase -%}
                  </div>
                {%- endfor -%}
              </div>

              {%- if product.media.size > 1 -%}
                <button type="button" class="mpc-gallery__arrow mpc-gallery__arrow--prev" data-mpc-prev aria-label="Previous">{% render 'mpc-icon', name: 'chevron-left' %}</button>
                <button type="button" class="mpc-gallery__arrow mpc-gallery__arrow--next" data-mpc-next aria-label="Next">{% render 'mpc-icon', name: 'chevron-right' %}</button>
                <div class="mpc-gallery__progress" aria-hidden="true"><span data-mpc-progress style="width: {{ 100.0 | divided_by: product.media.size }}%;"></span></div>
              {%- endif -%}
            </div>
          </div>

          <dialog class="mpc-lightbox" data-mpc-lightbox aria-label="{{ product.title | escape }}">
            <button type="button" class="mpc-lightbox__close" data-mpc-lightbox-close aria-label="{{ 'accessibility.close' | t }}">{% render 'mpc-icon', name: 'close' %}</button>
            <div class="mpc-lightbox__list">
              {%- for media in product.media -%}
                {%- if media.media_type == 'image' -%}
                  <div class="mpc-lightbox__item" data-index="{{ forloop.index0 }}">
                    {{ media | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', widths: '800,1200,1600,2000,2400', alt: media.alt }}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </dialog>
        {%- else -%}
          <div class="mpc-gallery__placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {%- endif -%}
      </div>

      {%- comment -%} ============ ACCORDIONS (under gallery on desktop) ============ {%- endcomment -%}
      {%- if tab_blocks.size > 0 -%}
        <div class="mpc__tabs">
          {%- for block in tab_blocks -%}
            {%- liquid
              assign tab_content = ''
              if block.settings.metafield_key != blank
                assign mf_parts = block.settings.metafield_key | split: '.'
                assign mf = product.metafields[mf_parts[0]][mf_parts[1]]
                if mf != blank
                  assign tab_content = mf | metafield_tag
                endif
              endif
              if tab_content == blank and block.settings.use_description
                assign tab_content = product.description
              endif
              if tab_content == blank
                assign tab_content = block.settings.content | append: block.settings.page.content
              endif
            -%}
            {%- if tab_content != blank or request.design_mode -%}
              <details class="mpc-tab" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary class="mpc-tab__summary">
                  <span>{{ block.settings.heading | escape }}</span>
                  <span class="mpc-tab__icon" aria-hidden="true">{% render 'mpc-icon', name: 'plus' %}</span>
                </summary>
                <div class="mpc-tab__content mpc-rte">{{ tab_content }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} ============ PRODUCT INFO ============ {%- endcomment -%}
      <div class="mpc__info">
        <div class="mpc__info-inner{% if section.settings.sticky_info %} mpc__info-inner--sticky{% endif %}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}

              {%- when '@app' -%}
                <div class="mpc-block">{% render block %}</div>

              {%- when 'rating' -%}
                {%- liquid
                  assign rating_value = product.metafields.reviews.rating.value.rating | default: 0
                  assign rating_max = product.metafields.reviews.rating.value.scale_max | default: 5
                  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
                  assign rating_pct = rating_value | times: 100.0 | divided_by: rating_max
                -%}
                {%- if rating_count > 0 or block.settings.show_empty -%}
                  <div class="mpc-block mpc-rating" {{ block.shopify_attributes }}>
                    <span class="mpc-rating__stars" style="--mpc-rating: {{ rating_pct }}%;" aria-hidden="true">
                      <span class="mpc-rating__bg">★★★★★</span><span class="mpc-rating__fg">★★★★★</span>
                    </span>
                    <span class="visually-hidden">{{ rating_value | round: 1 }} / {{ rating_max }}</span>
                    <span class="mpc-rating__value">{{ rating_value | round: 1 }}</span>
                    <span class="mpc-rating__sep" aria-hidden="true">|</span>
                    <a href="{{ block.settings.reviews_anchor }}" class="mpc-rating__link" data-mpc-scroll-link>{{ rating_count }} {{ block.settings.reviews_label | escape }}</a>
                  </div>
                {%- endif -%}

              {%- when 'label' -%}
                {%- liquid
                  assign label_text = product.metafields.custom.collection_label.value
                  if label_text == blank
                    assign label_text = block.settings.text
                  endif
                  if label_text == blank and block.settings.vendor_fallback
                    assign label_text = product.vendor
                  endif
                -%}
                {%- if label_text != blank -%}
                  <p class="mpc-block mpc-label" {{ block.shopify_attributes }}>{{ label_text | escape }}</p>
                {%- endif -%}

              {%- when 'title' -%}
                <h1 class="mpc-block mpc-title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

              {%- when 'price' -%}
                <div class="mpc-block mpc-price" {{ block.shopify_attributes }}>
                  <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                  <span class="mpc-price__current" data-mpc-price>{{ current_variant.price | money }}</span>
                  <s class="mpc-price__compare" data-mpc-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
                  {%- if block.settings.show_badge -%}
                    <span class="mpc-price__badge" data-mpc-sale-badge {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ block.settings.badge_text | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.show_tax and cart.taxes_included -%}
                    <p class="mpc-price__tax">{{ 'products.product.taxes_included' | t }}</p>
                  {%- endif -%}
                </div>

              {%- when 'variant_picker' -%}
                {%- unless single_variant -%}
                  {%- liquid
                    assign swatch_names = block.settings.swatch_options | downcase | split: ','
                    assign chart_names = block.settings.size_chart_options | downcase | split: ','
                    assign has_size_chart = false
                    if product.metafields.custom.size_chart != blank or block.settings.size_chart_page != blank or block.settings.size_chart_content != blank or block.settings.size_chart_image != blank
                      assign has_size_chart = true
                    endif
                  -%}
                  <div class="mpc-block mpc-variants" data-mpc-variants {{ block.shopify_attributes }}>
                    {%- for option in product.options_with_values -%}
                      {%- liquid
                        assign option_down = option.name | downcase | strip
                        assign is_swatch = false
                        for s in swatch_names
                          assign s_clean = s | strip
                          if s_clean == option_down
                            assign is_swatch = true
                          endif
                        endfor
                        assign is_chart = false
                        for c in chart_names
                          assign c_clean = c | strip
                          if c_clean == option_down
                            assign is_chart = true
                          endif
                        endfor
                        assign option_heading = option.name
                        if is_chart and block.settings.size_heading != blank
                          assign option_heading = block.settings.size_heading
                        endif
                      -%}
                      <fieldset class="mpc-option{% if is_swatch %} mpc-option--swatch{% endif %}" data-option-position="{{ option.position }}">
                        <div class="mpc-option__head">
                          <legend class="mpc-option__legend">
                            {{ option_heading | escape }}:
                            {%- if is_swatch -%}<span class="mpc-option__selected" data-mpc-selected-value>{{ option.selected_value | escape }}</span>{%- endif -%}
                          </legend>
                          {%- if is_chart and has_size_chart -%}
                            <button type="button" class="mpc-option__chart" data-mpc-open-dialog="mpc-sizechart-{{ section.id }}">{{ block.settings.size_chart_label | escape }}</button>
                          {%- endif -%}
                        </div>
                        <div class="mpc-option__values">
                          {%- for value in option.values -%}
                            {%- assign value_name = value.name | default: value -%}
                            {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 -%}
                            <input
                              type="radio"
                              class="mpc-option__input"
                              id="{{ input_id }}"
                              name="mpc-option-{{ section.id }}-{{ option.position }}"
                              value="{{ value | escape }}"
                              {% if option.selected_value == value_name %}checked{% endif %}
                            >
                            {%- if is_swatch -%}
                              {%- liquid
                                assign swatch_img = value.swatch.image
                                assign opt_index = option.position | minus: 1
                                if swatch_img == blank
                                  for v in product.variants
                                    if v.options[opt_index] == value_name and v.featured_image
                                      assign swatch_img = v.featured_image
                                      break
                                    endif
                                  endfor
                                endif
                              -%}
                              <label for="{{ input_id }}" class="mpc-swatch" title="{{ value | escape }}">
                                {%- if swatch_img != blank -%}
                                  {{ swatch_img | image_url: width: 160 | image_tag: loading: 'lazy', alt: value_name }}
                                {%- elsif value.swatch.color -%}
                                  <span class="mpc-swatch__color" style="background: {{ value.swatch.color }};"></span>
                                {%- else -%}
                                  <span class="mpc-swatch__text">{{ value | escape }}</span>
                                {%- endif -%}
                                <span class="visually-hidden">{{ value | escape }}</span>
                              </label>
                            {%- else -%}
                              <label for="{{ input_id }}" class="mpc-pill">{{ value | escape }}</label>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      </fieldset>
                    {%- endfor -%}
                  </div>

                  {%- if has_size_chart -%}
                    <dialog class="mpc-dialog" id="mpc-sizechart-{{ section.id }}" aria-label="{{ block.settings.size_chart_label | escape }}">
                      <div class="mpc-dialog__panel">
                        <div class="mpc-dialog__head">
                          <h2 class="mpc-dialog__title">{{ block.settings.size_chart_label | escape }}</h2>
                          <button type="button" class="mpc-dialog__close" data-mpc-close-dialog aria-label="{{ 'accessibility.close' | t }}">{% render 'mpc-icon', name: 'close' %}</button>
                        </div>
                        <div class="mpc-dialog__body mpc-rte">
                          {%- assign chart_mf = product.metafields.custom.size_chart -%}
                          {%- if chart_mf != blank -%}
                            {%- case chart_mf.type -%}
                              {%- when 'page_reference' -%}
                                {{ chart_mf.value.content }}
                              {%- when 'file_reference' -%}
                                {{ chart_mf.value | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1200,1400' }}
                              {%- else -%}
                                {{ chart_mf | metafield_tag }}
                            {%- endcase -%}
                          {%- else -%}
                            {%- if block.settings.size_chart_image != blank -%}
                              {{ block.settings.size_chart_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1200,1400' }}
                            {%- endif -%}
                            {{ block.settings.size_chart_content }}
                            {{ block.settings.size_chart_page.content }}
                          {%- endif -%}
                        </div>
                      </div>
                    </dialog>
                  {%- endif -%}
                {%- endunless -%}

              {%- when 'delivery' -%}
                {%- liquid
                  assign d_min = product.metafields.custom.delivery_min_days.value | default: block.settings.min_days
                  assign d_max = product.metafields.custom.delivery_max_days.value | default: block.settings.max_days
                -%}
                <div
                  class="mpc-block mpc-delivery"
                  data-mpc-delivery
                  data-min="{{ d_min }}"
                  data-max="{{ d_max }}"
                  data-skip="{{ block.settings.skip_days }}"
                  data-cutoff="{{ block.settings.cutoff_hour }}"
                  style="--mpc-dot: {{ block.settings.dot_color }};"
                  {{ block.shopify_attributes }}
                >
                  <span class="mpc-delivery__dot" aria-hidden="true"></span>
                  <span class="mpc-delivery__text">
                    {{ block.settings.text_before | escape }}
                    <strong data-mpc-delivery-from></strong>
                    {{ block.settings.text_between | escape }}
                    <strong data-mpc-delivery-to></strong>
                  </span>
                </div>

              {%- when 'features' -%}
                {%- assign mf_highlights = product.metafields.custom.highlights.value -%}
                <ul class="mpc-block mpc-features" role="list" {{ block.shopify_attributes }}>
                  {%- if mf_highlights != blank -%}
                    {%- for text in mf_highlights limit: 8 -%}
                      {%- liquid
                        assign icon_key = 'icon_' | append: forloop.index
                        assign img_key = 'icon_image_' | append: forloop.index
                        assign icon_name = block.settings[icon_key] | default: 'sparkle'
                        assign icon_img = block.settings[img_key]
                      -%}
                      <li class="mpc-features__item">
                        <span class="mpc-features__icon">
                          {%- if icon_img != blank -%}{{ icon_img | image_url: width: 64 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{% render 'mpc-icon', name: icon_name %}{%- endif -%}
                        </span>
                        <span>{{ text | escape }}</span>
                      </li>
                    {%- endfor -%}
                  {%- else -%}
                    {%- for i in (1..6) -%}
                      {%- liquid
                        assign text_key = 'text_' | append: i
                        assign icon_key = 'icon_' | append: i
                        assign img_key = 'icon_image_' | append: i
                        assign text = block.settings[text_key]
                        assign icon_name = block.settings[icon_key]
                        assign icon_img = block.settings[img_key]
                      -%}
                      {%- if text != blank -%}
                        <li class="mpc-features__item">
                          <span class="mpc-features__icon">
                            {%- if icon_img != blank -%}{{ icon_img | image_url: width: 64 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{% render 'mpc-icon', name: icon_name %}{%- endif -%}
                          </span>
                          <span>{{ text }}</span>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                </ul>

              {%- when 'gift_wrap' -%}
                <label class="mpc-block mpc-gift" {{ block.shopify_attributes }}>
                  <input
                    type="checkbox"
                    class="mpc-gift__input"
                    form="{{ form_id }}"
                    name="properties[{{ block.settings.property_name | escape }}]"
                    value="{{ block.settings.property_value | escape }}"
                  >
                  <span class="mpc-gift__check" aria-hidden="true"></span>
                  <span class="mpc-gift__text">{{ block.settings.text | escape }}</span>
                  {%- if block.settings.image != blank -%}
                    <span class="mpc-gift__image">{{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}</span>
                  {%- endif -%}
                </label>

              {%- when 'buy_buttons' -%}
                <div class="mpc-block mpc-buy" {{ block.shopify_attributes }}>
                  <product-form class="mpc-buy__form" data-hide-errors="false">
                    {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                      <input type="hidden" name="id" value="{{ current_variant.id }}" data-mpc-variant-id>
                      <div class="mpc-buy__row">
                        {%- if block.settings.show_quantity -%}
                          <div class="mpc-qty">
                            <button type="button" class="mpc-qty__btn" data-mpc-qty="-1" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}">{% render 'mpc-icon', name: 'minus' %}</button>
                            <input class="mpc-qty__input" type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity.label' | t }}">
                            <button type="button" class="mpc-qty__btn" data-mpc-qty="1" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}">{% render 'mpc-icon', name: 'plus' %}</button>
                          </div>
                        {%- endif -%}
                        <button
                          type="submit"
                          name="add"
                          class="mpc-atc"
                          data-mpc-atc
                          data-label-add="{{ block.settings.button_label | escape }}"
                          data-label-soldout="{{ 'products.product.sold_out' | t | escape }}"
                          data-label-unavailable="{{ 'products.product.unavailable' | t | escape }}"
                          {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}
                        >
                          {%- render 'mpc-icon', name: 'bag' -%}
                          <span data-mpc-atc-label>{%- if current_variant.available -%}{{ block.settings.button_label | escape }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
                          <span class="loading__spinner loading-overlay__spinner hidden"><span class="mpc-spinner"></span></span>
                        </button>
                      </div>
                      {%- if block.settings.show_dynamic_checkout -%}
                        <div class="mpc-buy__dynamic">{{ form | payment_button }}</div>
                      {%- endif -%}
                      <div class="product-form__error-message-wrapper mpc-buy__error" role="alert" hidden>
                        <span class="product-form__error-message"></span>
                      </div>
                    {%- endform -%}
                  </product-form>
                </div>

              {%- when 'installments' -%}
                <div class="mpc-block mpc-installments" {{ block.shopify_attributes }}>
                  <span>{{ block.settings.text_before | escape }} <strong data-mpc-installment>{{ current_variant.price | divided_by: block.settings.count | money }}</strong> {{ block.settings.text_after | escape }}</span>
                  {%- if block.settings.logo_1 != blank -%}{{ block.settings.logo_1 | image_url: height: 40 | image_tag: loading: 'lazy', class: 'mpc-installments__logo', alt: block.settings.logo_1.alt }}{%- endif -%}
                  {%- if block.settings.logo_2 != blank -%}{{ block.settings.logo_2 | image_url: height: 40 | image_tag: loading: 'lazy', class: 'mpc-installments__logo', alt: block.settings.logo_2.alt }}{%- endif -%}
                </div>

              {%- when 'complete_the_look' -%}
                {%- render 'mpc-complete-look', block: block, product: product -%}

              {%- when 'trust_badges' -%}
                {%- render 'mpc-trust-badges', block: block -%}

              {%- when 'text' -%}
                <div class="mpc-block mpc-text mpc-rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="mpc-block mpc-text mpc-rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
                {%- endif -%}

              {%- when 'custom_liquid' -%}
                <div class="mpc-block" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ============ STICKY ADD TO BAG ============ {%- endcomment -%}
  {%- assign buy_block = section.blocks | where: 'type', 'buy_buttons' | first -%}
  {%- if buy_block and buy_block.settings.enable_sticky -%}
    <div class="mpc-sticky" data-mpc-sticky aria-hidden="true">
      <div class="mpc-sticky__inner">
        <p class="mpc-sticky__title">
          <span>{{ buy_block.settings.sticky_label | escape }}</span>
          {{ product.title | escape }}<span data-mpc-sticky-variant>{% unless single_variant %} – {{ current_variant.title | escape }}{% endunless %}</span>
        </p>
        <button type="submit" form="{{ form_id }}" class="mpc-sticky__btn" data-mpc-sticky-btn tabindex="-1" {% unless current_variant.available %}disabled{% endunless %}>
          {%- render 'mpc-icon', name: 'bag' -%}
          <span data-mpc-atc-label>{%- if current_variant.available -%}{{ buy_block.settings.button_label | escape }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
        </button>
      </div>
    </div>
  {%- endif -%}

  <script type="application/json" data-mpc-json>
    {
      "singleVariant": {{ single_variant | json }},
      "variants": [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id }},
            "title": {{ v.title | json }},
            "options": {{ v.options | json }},
            "available": {{ v.available | json }},
            "price": {{ v.price | money | json }},
            "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
            "installment": {{ v.price | divided_by: installment_count | money | json }},
            "media": {% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</main-product-custom>
<script>
(function(){
  if (window.__themeRevealInit) { if (window.__themeRevealScan) window.__themeRevealScan(); return; }
  window.__themeRevealInit = true;
  var supportsIO = 'IntersectionObserver' in window;
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var observer;
  function reveal(el){ el.classList.add('is-visible'); }
  function ensureObserver(){
    if (observer || !supportsIO) return;
    observer = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if (entry.isIntersecting){
          reveal(entry.target);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
  }
  function scan(root){
    root = (root && root.querySelectorAll) ? root : document;
    var els = root.querySelectorAll('.reveal-fade:not(.is-visible):not([data-reveal-bound])');
    els.forEach(function(el){
      el.setAttribute('data-reveal-bound', 'true');
      if (!supportsIO || reduceMotion){ reveal(el); return; }
      ensureObserver();
      observer.observe(el);
    });
  }
  window.__themeRevealScan = scan;
  if (document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', function(){ scan(); });
  } else {
    scan();
  }
  document.addEventListener('shopify:section:load', function(e){ scan(e.target); });
})();
</script>

