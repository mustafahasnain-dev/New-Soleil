{%- comment -%}
  Split image / text promo (e.g. gifts), modelled on minimalist.ae: a large image on one half,
  a dark panel on the other with a small eyebrow, heading, text and up to two pill buttons.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = '#shopify-section-' | append: section.id
-%}
<style>
  {{ sid }} .gift-split{ display:grid; grid-template-columns:1fr 1fr; min-height:{{ s.min_height }}px; background:{{ s.bg_color }}; color:{{ s.text_color }};{% unless s.full_width %} max-width:1620px; margin:0 auto;{% endunless %} }
  {{ sid }} .gift-split--right .gift-split__media{ order:2; }
  {{ sid }} .gift-split__media{ position:relative; overflow:hidden; background:rgba(127,127,127,.15); }
  {{ sid }} .gift-split__media img, {{ sid }} .gift-split__media svg{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  {{ sid }} .gift-split__media .gift-split__img--mobile{ display:none; }
  {{ sid }} .gift-split__content{ display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; padding:60px clamp(24px,6vw,110px); }
  {{ sid }} .gift-split__eyebrow{ margin:0 0 30px; font-size:12px; letter-spacing:.12em; text-transform:uppercase; color:inherit; }
  {{ sid }} .gift-split__heading{ margin:0 0 18px; font-size:clamp(24px,2.2vw,32px); font-weight:400; line-height:1.2; letter-spacing:.02em; text-transform:uppercase; color:inherit; }
  {{ sid }} .gift-split__text{ max-width:560px; margin:0 0 36px; font-size:14px; line-height:1.9; letter-spacing:.02em; text-transform:uppercase; color:inherit; }
  {{ sid }} .gift-split__text p{ margin:0; color:inherit; }
  {{ sid }} .gift-split__buttons{ display:flex; flex-wrap:wrap; justify-content:center; gap:16px; }
  {{ sid }} .gift-split__btn{ display:inline-flex; align-items:center; justify-content:center; min-width:240px; min-height:50px; padding:12px 32px; border-radius:999px; border:1px solid {{ s.text_color }}; font-size:13px; letter-spacing:.1em; text-transform:uppercase; text-decoration:none; transition:background-color .2s ease, color .2s ease, border-color .2s ease; }
  {{ sid }} .gift-split__btn--solid{ background:{{ s.btn_bg }}; border-color:{{ s.btn_bg }}; color:{{ s.btn_text }}; }
  {{ sid }} .gift-split__btn--outline{ background:transparent; color:{{ s.text_color }}; }
  {{ sid }} .gift-split__btn--solid:hover{ background:transparent; border-color:{{ s.text_color }}; color:{{ s.text_color }}; }
  {{ sid }} .gift-split__btn--outline:hover{ background:{{ s.text_color }}; color:{{ s.bg_color }}; }
  @media screen and (max-width:749px){
    {{ sid }} .gift-split{ grid-template-columns:1fr; min-height:0; }
    {{ sid }} .gift-split--right .gift-split__media{ order:0; }
    {{ sid }} .gift-split__media{ aspect-ratio:{{ s.mobile_ratio }}; }
    {%- if s.image_mobile != blank %}
    {{ sid }} .gift-split__media .gift-split__img--desktop{ display:none; }
    {{ sid }} .gift-split__media .gift-split__img--mobile{ display:block; }
    {%- endif %}
    {{ sid }} .gift-split__content{ padding:48px 20px; }
    {{ sid }} .gift-split__eyebrow{ margin-bottom:20px; }
    {{ sid }} .gift-split__text{ font-size:13px; margin-bottom:28px; }
    {{ sid }} .gift-split__buttons{ flex-direction:column; width:100%; max-width:340px; }
    {{ sid }} .gift-split__btn{ min-width:0; width:100%; }
  }
</style>

<div class="gift-split gift-split--{{ s.image_position }}">
  <div class="gift-split__media">
    {%- if s.image != blank -%}
      {{ s.image | image_url: width: 1800 | image_tag: class: 'gift-split__img--desktop', loading: 'lazy', widths: '600, 900, 1200, 1500, 1800', sizes: '(min-width: 750px) 50vw, 100vw', alt: s.heading }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'gift-split__img--desktop' }}
    {%- endif -%}
    {%- if s.image_mobile != blank -%}
      {{ s.image_mobile | image_url: width: 1000 | image_tag: class: 'gift-split__img--mobile', loading: 'lazy', widths: '500, 750, 1000', sizes: '100vw', alt: s.heading }}
    {%- endif -%}
  </div>
  <div class="gift-split__content">
    {%- if s.eyebrow != blank -%}<p class="gift-split__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="gift-split__heading">{{ s.heading | escape }}</h2>{%- endif -%}
    {%- if s.text != blank -%}<div class="gift-split__text">{{ s.text }}</div>{%- endif -%}
    {%- if s.button_label_1 != blank or s.button_label_2 != blank -%}
      <div class="gift-split__buttons">
        {%- if s.button_label_1 != blank -%}<a href="{{ s.button_link_1 | default: '#' }}" class="gift-split__btn gift-split__btn--solid">{{ s.button_label_1 | escape }}</a>{%- endif -%}
        {%- if s.button_label_2 != blank -%}<a href="{{ s.button_link_2 | default: '#' }}" class="gift-split__btn gift-split__btn--outline">{{ s.button_label_2 | escape }}</a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Gift split banner",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional. Defaults to the image above." },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Luxury gift box sets" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Give the perfect gift, every time" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Premium packaging, timeless elegance, and handcrafted pieces all wrapped in a signature gift box.</p>" },
    { "type": "text", "id": "button_label_1", "label": "Button 1 label", "default": "Shop curated gifts" },
    { "type": "url", "id": "button_link_1", "label": "Button 1 link" },
    { "type": "text", "id": "button_label_2", "label": "Button 2 label", "default": "Shop personalised products" },
    { "type": "url", "id": "button_link_2", "label": "Button 2 link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Panel background", "default": "#1e1e1e" },
    { "type": "color", "id": "text_color", "label": "Text and outline", "default": "#ffffff" },
    { "type": "color", "id": "btn_bg", "label": "Button 1 background", "default": "#e3dfda" },
    { "type": "color", "id": "btn_text", "label": "Button 1 text", "default": "#1e1e1e" },
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true, "info": "Off keeps it within the 1620px page width." },
    { "type": "range", "id": "min_height", "label": "Desktop height", "min": 400, "max": 1000, "step": 20, "unit": "px", "default": 760 },
    { "type": "select", "id": "mobile_ratio", "label": "Mobile image shape", "default": "4 / 5", "options": [ { "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait" }, { "value": "4 / 3", "label": "Landscape" } ] }
  ],
  "presets": [ { "name": "Gift split banner" } ]
}
{% endschema %}
