{%- comment -%}
  Homepage customer reviews: heading with an overall rating summary, then a swipeable row of review cards
  (stars, title, quote, name, optional location / product and photo) with prev / next arrows.
  Each review is a block, so reviews are added and edited in the theme editor.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sid = '#shopify-section-' | append: section.id
-%}
<style>
  {{ sid }} .reviews{ background:{{ s.bg_color }}; color:{{ s.text_color }}; padding:{{ s.padding_top }}px 0 {{ s.padding_bottom }}px; }
  {{ sid }} .reviews__inner{ max-width:1620px; margin:0 auto; padding:0 20px; }
  {{ sid }} .reviews__head{ display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:36px; }
  {{ sid }} .reviews__eyebrow{ margin:0 0 10px; font-size:12px; letter-spacing:.12em; text-transform:uppercase; color:inherit; opacity:.75; }
  {{ sid }} .reviews__heading{ margin:0; font-size:clamp(24px,2.4vw,34px); font-weight:400; letter-spacing:.03em; text-transform:uppercase; color:inherit; }
  {{ sid }} .reviews__summary{ display:flex; align-items:center; gap:12px; margin-top:12px; font-size:13px; letter-spacing:.04em; }
  {{ sid }} .reviews__nav{ display:flex; gap:10px; }
  {{ sid }} .reviews__arrow{ display:inline-flex; align-items:center; justify-content:center; width:44px; height:44px; padding:0; border:1px solid currentColor; border-radius:50%; background:transparent; color:inherit; cursor:pointer; transition:background-color .2s ease, color .2s ease, opacity .2s ease; }
  {{ sid }} .reviews__arrow:hover{ background:{{ s.text_color }}; color:{{ s.bg_color }}; }
  {{ sid }} .reviews__arrow:disabled{ opacity:.3; cursor:default; background:transparent; color:inherit; }
  {{ sid }} .reviews__track{ display:grid; grid-auto-flow:column; grid-auto-columns:calc((100% - {{ s.columns | minus: 1 | times: 20 }}px) / {{ s.columns }}); gap:20px; overflow-x:auto; scroll-snap-type:x mandatory; scroll-behavior:smooth; scrollbar-width:none; padding-bottom:4px; }
  {{ sid }} .reviews__track::-webkit-scrollbar{ display:none; }
  {{ sid }} .reviews__card{ display:flex; flex-direction:column; scroll-snap-align:start; padding:30px 28px; background:{{ s.card_color }}; border-radius:{{ s.card_radius }}px; }
  {{ sid }} .reviews__stars{ display:flex; gap:3px; color:{{ s.star_color }}; margin-bottom:18px; }
  {{ sid }} .reviews__stars svg{ width:16px; height:16px; }
  {{ sid }} .reviews__stars .is-empty{ opacity:.25; }
  {{ sid }} .reviews__title{ margin:0 0 10px; font-size:15px; font-weight:500; letter-spacing:.04em; text-transform:uppercase; color:inherit; }
  {{ sid }} .reviews__text{ flex:1; margin:0 0 24px; font-size:14px; line-height:1.75; color:inherit; }
  {{ sid }} .reviews__text p{ margin:0; color:inherit; }
  {{ sid }} .reviews__author{ display:flex; align-items:center; gap:12px; padding-top:18px; border-top:1px solid rgba(127,127,127,.25); }
  {{ sid }} .reviews__avatar{ flex:0 0 44px; width:44px; height:44px; border-radius:50%; overflow:hidden; background:rgba(127,127,127,.2); display:flex; align-items:center; justify-content:center; font-size:15px; text-transform:uppercase; }
  {{ sid }} .reviews__avatar img{ width:100%; height:100%; object-fit:cover; }
  {{ sid }} .reviews__name{ margin:0; font-size:13px; font-weight:500; letter-spacing:.06em; text-transform:uppercase; color:inherit; }
  {{ sid }} .reviews__meta{ margin:2px 0 0; font-size:12px; opacity:.7; color:inherit; }
  {{ sid }} .reviews__meta a{ color:inherit; }
  {{ sid }} .reviews__verified{ display:inline-flex; align-items:center; gap:4px; margin-left:6px; font-size:11px; letter-spacing:.04em; text-transform:uppercase; opacity:.8; }
  @media screen and (max-width:989px){ {{ sid }} .reviews__track{ grid-auto-columns:calc((100% - 20px) / 2); } }
  @media screen and (max-width:749px){
    {{ sid }} .reviews__track{ grid-auto-columns:85%; gap:14px; }
    {{ sid }} .reviews__card{ padding:24px 20px; }
    {{ sid }} .reviews__nav{ display:none; }
    {{ sid }} .reviews__head{ margin-bottom:24px; }
  }
</style>

{%- capture star -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2.8 2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8L12 2.8Z"/></svg>{%- endcapture -%}

<div class="reviews">
  <div class="reviews__inner">
    <div class="reviews__head">
      <div>
        {%- if s.eyebrow != blank -%}<p class="reviews__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="reviews__heading">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.show_summary and s.summary_rating != blank -%}
          <div class="reviews__summary">
            <span class="reviews__stars" style="margin:0" aria-hidden="true">
              {%- for i in (1..5) -%}<span{% if i > s.summary_rating %} class="is-empty"{% endif %}>{{ star }}</span>{%- endfor -%}
            </span>
            <span>{{ s.summary_text | escape }}</span>
          </div>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > s.columns -%}
        <div class="reviews__nav">
          <button type="button" class="reviews__arrow" data-reviews-prev aria-label="Previous reviews">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
          </button>
          <button type="button" class="reviews__arrow" data-reviews-next aria-label="Next reviews">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
          </button>
        </div>
      {%- endif -%}
    </div>

    <div class="reviews__track" data-reviews-track tabindex="0" aria-label="{{ s.heading | escape }}">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <article class="reviews__card" {{ block.shopify_attributes }}>
          <div class="reviews__stars" role="img" aria-label="{{ b.rating }} out of 5 stars">
            {%- for i in (1..5) -%}<span{% if i > b.rating %} class="is-empty"{% endif %}>{{ star }}</span>{%- endfor -%}
          </div>
          {%- if b.title != blank -%}<h3 class="reviews__title">{{ b.title | escape }}</h3>{%- endif -%}
          <div class="reviews__text">{{ b.text }}</div>
          <div class="reviews__author">
            <div class="reviews__avatar">
              {%- if b.photo != blank -%}
                {{ b.photo | image_url: width: 100 | image_tag: loading: 'lazy', alt: b.name }}
              {%- else -%}
                {{ b.name | slice: 0 }}
              {%- endif -%}
            </div>
            <div>
              <p class="reviews__name">
                {{- b.name | escape -}}
                {%- if b.verified -%}
                  <span class="reviews__verified"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4 10-10"/></svg>Verified</span>
                {%- endif -%}
              </p>
              {%- if b.location != blank or b.product != blank -%}
                <p class="reviews__meta">
                  {{- b.location | escape -}}
                  {%- if b.location != blank and b.product != blank %} · {% endif -%}
                  {%- if b.product != blank -%}<a href="{{ b.product.url }}">{{ b.product.title | escape }}</a>{%- endif -%}
                </p>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (() => {
    const root = document.querySelector('{{ sid }}');
    if (!root) return;
    const track = root.querySelector('[data-reviews-track]');
    const prev = root.querySelector('[data-reviews-prev]');
    const next = root.querySelector('[data-reviews-next]');
    if (!track || !prev || !next) return;
    const step = () => {
      const card = track.querySelector('.reviews__card');
      return card ? card.getBoundingClientRect().width + 20 : track.clientWidth;
    };
    const update = () => {
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', () => window.requestAnimationFrame(update), { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

{% schema %}
{
  "name": "Customer reviews",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Testimonials" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },
    { "type": "checkbox", "id": "show_summary", "label": "Show rating summary", "default": true },
    { "type": "range", "id": "summary_rating", "label": "Summary stars", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "text", "id": "summary_text", "label": "Summary text", "default": "4.9 / 5 based on 500+ reviews" },
    { "type": "range", "id": "columns", "label": "Reviews per row (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#f6f4f1" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "star_color", "label": "Stars", "default": "#202259" },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 0 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Review title" },
        { "type": "richtext", "id": "text", "label": "Review", "default": "<p>Beautiful piece and gorgeous packaging. It arrived quickly and looks even better in person.</p>" },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Customer name" },
        { "type": "text", "id": "location", "label": "Location", "info": "e.g. Dubai, UAE" },
        { "type": "product", "id": "product", "label": "Product reviewed" },
        { "type": "image_picker", "id": "photo", "label": "Customer photo", "info": "Optional. Shows the first letter of the name when empty." },
        { "type": "checkbox", "id": "verified", "label": "Show verified buyer", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer reviews",
      "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" }, { "type": "review" } ]
    }
  ]
}
{% endschema %}
