        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Where do you deliver?",
            "answer": "<p>We deliver across the United Arab Emirates. Available delivery destinations are shown at checkout when you enter your address.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Delivery time depends on your location. You’ll see the estimated delivery time at checkout, and we’ll email you tracking details as soon as your order is on its way.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "What are the shipping charges?",
            "answer": "<p>Shipping charges are calculated at checkout based on your delivery address and order. Any free-shipping offers that apply are shown in your cart and at checkout before you pay.</p>"
          }
        },
