        "question_2": {
          "type": "question",
          "settings": {
            "question": "Can I modify my order?",
            "answer": "<p>If you need to change something, contact us as soon as possible with your order number. We’re happy to help with changes such as the item or delivery address as long as your order hasn’t been dispatched yet.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Can I cancel my order?",
            "answer": "<p>Yes — orders can be cancelled before they are dispatched. Contact us with your order number and we’ll arrange the cancellation and refund to your original payment method. Once an order has shipped, please follow our returns process instead.</p>"
          }
        },
